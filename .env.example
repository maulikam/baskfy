# Decile — environment template. Copy to .env and fill in. NEVER commit real secrets.
# Env prefix is DECILE_ for application settings (docs/14-brand-and-naming.md).

# --- Database ---------------------------------------------------------------
# Async driver for the app; Alembic uses the same URL.
DECILE_DATABASE_URL=postgresql+asyncpg://decile:decile@localhost:5433/decile
# Port the compose stack publishes Postgres on (see infra/docker/compose.yml).
DECILE_POSTGRES_PORT=5433

# Database used by the `db`-marked pytest suite. Left unset -> those tests skip.
DECILE_TEST_DATABASE_URL=postgresql+asyncpg://decile:decile@localhost:5433/decile_test

# --- Cache / broker ---------------------------------------------------------
DECILE_REDIS_URL=redis://localhost:6380/0
DECILE_REDIS_PORT=6380

# --- Providers --------------------------------------------------------------
DECILE_KITE_API_KEY=
DECILE_KITE_API_SECRET=
# Fernet key encrypting the daily Kite access token at rest (docs/11 §Security).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DECILE_KITE_TOKEN_ENCRYPTION_KEY=
DECILE_KITE_TOKEN_PATH=.secrets/kite-token.enc
# docs/09: Kite allows ~3 req/s; day-interval history chunks into <=2000-day slices.
DECILE_KITE_RATE_LIMIT_PER_SECOND=3
DECILE_KITE_MAX_DAYS_PER_REQUEST=2000
DECILE_KITE_MAX_CONCURRENCY=3

# NSE public files are rate-sensitive (docs/09 §"NSE specifics").
DECILE_NSE_RATE_LIMIT_PER_SECOND=1
DECILE_NSE_REQUEST_TIMEOUT_SECONDS=30

# Retry and circuit-breaker budgets shared by every provider.
DECILE_PROVIDER_MAX_ATTEMPTS=5
DECILE_PROVIDER_BACKOFF_BASE_SECONDS=0.5
DECILE_PROVIDER_BACKOFF_MAX_SECONDS=30
DECILE_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
DECILE_PROVIDER_CIRCUIT_RESET_SECONDS=60

# --- Object storage (Prompt 2+) ---------------------------------------------
DECILE_S3_ENDPOINT_URL=
DECILE_S3_REGION=auto
DECILE_S3_BUCKET=decile-local
DECILE_S3_ACCESS_KEY_ID=
DECILE_S3_SECRET_ACCESS_KEY=

# --- Payments (Prompt 13) ---------------------------------------------------
DECILE_RAZORPAY_KEY_ID=
DECILE_RAZORPAY_KEY_SECRET=
DECILE_RAZORPAY_WEBHOOK_SECRET=

# --- Email (Prompt 12) ------------------------------------------------------
DECILE_RESEND_API_KEY=

# --- Auth (docs/07, docs/11 §Security) --------------------------------------
# HS256 shared secret between apps/web (Auth.js) and services/api (docs/03). The API verifies
# tokens; apps/web issues them (Prompt 12). RFC 7518 §3.2 requires at least 32 bytes for HS256,
# and `DECILE_ENVIRONMENT=production` refuses to start with anything shorter.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DECILE_JWT_SECRET=
# Optional; when set, a token whose `iss`/`aud` do not match is refused.
DECILE_JWT_ISSUER=
DECILE_JWT_AUDIENCE=
# docs/11: "15-min access". A correctly signed token with a longer lifetime is still refused.
DECILE_JWT_MAX_LIFETIME_SECONDS=900

# --- API service (Prompt 7) -------------------------------------------------
# local | test | staging | production. `production` enforces the checks in Settings.require_configured.
DECILE_ENVIRONMENT=local
# docs/07 §Conventions. The API-key tier is unreachable until Prompt 20 issues keys.
DECILE_RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
DECILE_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60
DECILE_RATE_LIMIT_API_KEY_PER_MINUTE=600
DECILE_RATE_LIMIT_ENABLED=true
# Comma-separated; the Next.js dev server by default.
DECILE_CORS_ORIGINS=["http://localhost:3000"]

# --- Observability (docs/02 §Observability) ---------------------------------
DECILE_LOG_LEVEL=INFO
# false gives human-readable lines; true gives one JSON object per line for Loki.
DECILE_LOG_JSON=false
DECILE_OTEL_ENABLED=false
DECILE_OTEL_SERVICE_NAME=decile-api
# Leave empty with OTEL enabled to create spans and drop them (useful in tests).
DECILE_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web (apps/web, Prompt 8) -----------------------------------------------
# The API origin. The /api/v1 prefix is stripped by the client, so either form works.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Canonical site origin, used for metadata, robots.txt and the sitemap (docs/14).
NEXT_PUBLIC_SITE_URL=https://decile.in
# Auth.js's own cookie-encryption secret. Separate from DECILE_JWT_SECRET, which is the shared
# secret the API verifies bearer tokens with — they are different keys for different jobs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# The same database as DECILE_DATABASE_URL, without SQLAlchemy's `+asyncpg` driver suffix —
# `pg` is a plain PostgreSQL client and does not understand it.
DECILE_DATABASE_URL_PG=postgresql://decile:decile@localhost:5433/decile
