# Create an app at https://developers.kite.trade (₹2000/mo Kite Connect subscription)
# Set the app's Redirect URL to: http://127.0.0.1:8420/callback
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
DRY_RUN=true            # keep true until the plan output looks right for 2-3 sessions
FULLY_INVESTED=false    # true = ignore cash bands (your zero-cash preference)
PORT=8420
