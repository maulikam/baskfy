# Baskfy — the one environment schema
#
# Two halves, deliberately still spelled differently, and the reason is operational:
#
#   BASKFY_*      the data plant (screener, API, worker, web). Renamed at M2.
#   unprefixed    the execution desk. Its variables keep their existing names until M15+,
#                 because the deployed Mumbai box reads this schema and a rename shipped
#                 ahead of the code would break a live, order-placing system on the next
#                 `git pull`. The desk moves when its code moves, not before.
#
# EVERY VARIABLE IS MARKED, per docs/03 §3f:
#
#   # user-editable   a person may change it at runtime. In the desk these are exactly the
#                     keys `app/analytics/settings.py` exposes as a Spec — validated, typed,
#                     range-checked and written to the settings_audit table.
#   # system-only     server configuration. Never a form field, never rendered in a browser,
#                     never stored in the database. Credentials, safety switches, risk
#                     ceilings, rate caps, infrastructure.
#
# The split is a SECURITY BOUNDARY, not a preference. docs/03 §3f states it plainly:
# "RISK_MAX_DAILY_LOSS_PCT must not become a form field." Under multi-tenancy (P4) a
# user-editable risk ceiling is privilege escalation — a user raising their own loss cap.
# `tests/test_settings_boundary.py` enforces it; see docs/DECISIONS-MERGE.md M4.1 for the
# one place today's desk does not yet satisfy it, and why that is a deliberate, dated gap.
#
# The screener has NO user-editable environment at all: what a user tunes there lives in a
# saved ScreenDefinition, not in the process environment. That is the design §3f asks for,
# and it is why every BASKFY_* below is system-only.
#
# Neither half of this file is loaded directly. Copy the sections you need into
# decile-blueprint/.env and kite-momentum-rebalancer/.env respectively; both stay untracked.



# ======================================================================================
# THE DATA PLANT — decile-blueprint/.env
# ======================================================================================

# Baskfy — environment template. Copy to .env and fill in. NEVER commit real secrets.
# Env prefix is BASKFY_ for application settings (docs/14-brand-and-naming.md).

# --- Database ---------------------------------------------------------------
# Async driver for the app; Alembic uses the same URL.
BASKFY_DATABASE_URL=postgresql+asyncpg://baskfy:baskfy@localhost:5433/baskfy  # system-only
# Port the compose stack publishes Postgres on (see infra/docker/compose.yml).
BASKFY_POSTGRES_PORT=5433                                                     # system-only

# Database used by the `db`-marked pytest suite. Left unset -> those tests skip.
BASKFY_TEST_DATABASE_URL=postgresql+asyncpg://baskfy:baskfy@localhost:5433/baskfy_test # system-only

# --- Operator safety: NOT defaults, and a rebuilt box loses them silently --------
# Every var below is set by hand on the Phase A box and exists in no image. They were added
# 31 Aug - 1 Sep 2026 and are recorded here because a rebuild that omits them does not fail —
# it comes up quietly wrong, which is worse.
#
# Who may sign in. EMPTY MEANS OPEN: every verified Google account. A rebuilt box with this
# unset is a box anyone can register on. Comma-separated, case-insensitive (M60).
BASKFY_LOGIN_ALLOWLIST=                                                       # user-editable
#
# Overrides compose.prod.yml's DRY_RUN, whose default stays "true". Setting it false unlocks
# exactly one capability — Kite's read-only GET /portfolio/holdings — and cannot reach an order:
# services/api has no .place( call and no execute route. Leave unset to stay dry.
BASKFY_DRY_RUN=                                                               # user-editable
#
# Where Caddy forwards a bare Kite login return (request_token present, no state) so the desk
# still gets its morning session while the console redirect points at Baskfy. Defaults to
# https://desk.modelbasket.in/callback. Empty this when the desk is retired (M64).
BASKFY_DESK_CALLBACK_URL=                                                     # system-only

# --- Cache / broker ---------------------------------------------------------
BASKFY_REDIS_URL=redis://localhost:6380/0                                     # system-only
BASKFY_REDIS_PORT=6380                                                        # system-only

# --- Providers --------------------------------------------------------------
BASKFY_KITE_API_KEY=                                                          # system-only
# LEAVE EMPTY on any deployment where the momentum desk still trades. One Kite Connect app has
# one redirect and one live access token per user. With a secret set, a Baskfy login completes a
# real session/token exchange and INVALIDATES the desk's session — and the desk is what places
# the orders. Empty is what makes the M64 bridge work: Baskfy cannot redeem the single-use
# request_token, so it forwards it to the desk, which can. Set it only when the desk is retired,
# or when you accept re-logging the desk in after every Baskfy connect.
# Setting it is also what makes the Zerodha Connect button appear — `_connect_configured()`
# wants key + secret + a redirect that returns to Baskfy (M68).
BASKFY_KITE_API_SECRET=                                                       # system-only
# Fernet key encrypting the daily Kite access token at rest (docs/11 §Security).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BASKFY_KITE_TOKEN_ENCRYPTION_KEY=                                             # system-only
BASKFY_KITE_TOKEN_PATH=.secrets/kite-token.enc                                # system-only
# docs/09: Kite allows ~3 req/s; day-interval history chunks into <=2000-day slices.
BASKFY_KITE_RATE_LIMIT_PER_SECOND=3                                           # system-only
BASKFY_KITE_MAX_DAYS_PER_REQUEST=2000                                         # system-only
BASKFY_KITE_MAX_CONCURRENCY=3                                                 # system-only

# NSE public files are rate-sensitive (docs/09 §"NSE specifics").
BASKFY_NSE_RATE_LIMIT_PER_SECOND=1                                            # system-only
BASKFY_NSE_REQUEST_TIMEOUT_SECONDS=30                                         # system-only

# Retry and circuit-breaker budgets shared by every provider.
BASKFY_PROVIDER_MAX_ATTEMPTS=5                                                # system-only
BASKFY_PROVIDER_BACKOFF_BASE_SECONDS=0.5                                      # system-only
BASKFY_PROVIDER_BACKOFF_MAX_SECONDS=30                                        # system-only
BASKFY_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5                                   # system-only
BASKFY_PROVIDER_CIRCUIT_RESET_SECONDS=60                                      # system-only

# --- Object storage (Prompt 2+) ---------------------------------------------
BASKFY_S3_ENDPOINT_URL=                                                       # system-only
BASKFY_S3_REGION=auto                                                         # system-only
BASKFY_S3_BUCKET=baskfy-local                                                 # system-only
BASKFY_S3_ACCESS_KEY_ID=                                                      # system-only
BASKFY_S3_SECRET_ACCESS_KEY=                                                  # system-only

# --- Payments (docs/02 §Payments: Razorpay; Prompt 13) ----------------------
# Use TEST-mode credentials everywhere but production. `BASKFY_ENVIRONMENT=production` refuses to
# start without the key pair and the webhook secret (docs/11 §Security: "verify signature").
BASKFY_RAZORPAY_KEY_ID=                                                       # system-only
BASKFY_RAZORPAY_KEY_SECRET=                                                   # system-only
# NOT the key secret. Razorpay signs a webhook with the value configured on the webhook itself.
BASKFY_RAZORPAY_WEBHOOK_SECRET=                                               # system-only
# Razorpay subscriptions bill against a plan created in *their* dashboard, which has its own id.
# Environment-specific (test vs live), so it is configuration rather than seed data.
BASKFY_RAZORPAY_PLAN_ID_MONTHLY=                                              # system-only
BASKFY_RAZORPAY_PLAN_ID_YEARLY=                                               # system-only

# --- GST invoicing (docs/11 §"Compliance & legal (India)"; Prompt 13) -------
# ⚠️ The rate and the SAC below are defaults, NOT advice. A chartered accountant must confirm both
# before the first real charge — see docs/DECISIONS.md §13.2.
BASKFY_GST_RATE_PERCENT=18                                                    # system-only
BASKFY_GST_SAC_CODE=998439                                                    # system-only
# The supplier's own particulars. Every one of them is printed on the invoice.
BASKFY_SUPPLIER_LEGAL_NAME=Baskfy                                             # system-only
# A JSON list, e.g. ["12 MG Road","Bengaluru 560001"]
BASKFY_SUPPLIER_ADDRESS_LINES=[]                                              # system-only
BASKFY_SUPPLIER_GSTIN=                                                        # system-only
# Spelled as the GST return expects it, e.g. "Karnataka (29)". Also the default place of supply
# for a customer whose own state we do not hold (IGST Act §12(2)(b)).
BASKFY_SUPPLIER_STATE=                                                        # system-only
# Invoice numbers are DCL/2026-27/000001 — prefix / financial year / gapless running number.
BASKFY_INVOICE_SERIES_PREFIX=DCL                                              # system-only
# Where invoice PDFs go when no S3/R2 bucket is configured above.
BASKFY_INVOICE_LOCAL_DIR=.archive                                             # system-only

# --- Feature flags (docs/11 §Reliability: "anything touching money") --------
# PROMPTS.md Prompt 13 §5's optional ₹0 tier, limited to NIFTY 50. Off by default. Turning it on
# needs `make seed` re-run: the plan row is only created while the flag is set.
BASKFY_FREE_TIER_ENABLED=false                                                # system-only
# PROMPTS.md Prompt 20 §2's public read API. **OFF, and it must stay off.** docs/11 §Compliance:
# "Get a written data-redistribution opinion before enabling the public API tier." Setting this to
# true is NOT sufficient and NOT permission — the router also refuses to mount until
# `baskfy_core.public_api.DATA_REDISTRIBUTION_REVIEW.signed_off` is flipped in source, which is a
# reviewable commit. See docs/DECISIONS.md §20.1.
BASKFY_PUBLIC_API_ENABLED=false                                               # system-only

# Phase 4 start (P4.1 / P4.3). Founder tenant ids. A second paying tenant still waits
# on counsel C3; these are not permission to collect money or open public signup.
BASKFY_SOLE_USER_ID=1                                                         # system-only
BASKFY_SOLE_BROKER_ACCOUNT_ID=1                                                # system-only

# --- Swing (docs/swing) -------------------------------------------------------------
# Kullamägi-style swing setups: flags, episodic pivots, the opening-range monitor. The three
# *_ENABLED flags are Track B in docs/swing/02-scope-and-gating.md: built dark, default off,
# tests assert unreachability. EXECUTION flips only by Maulik's hand after the §3 gate
# (20 DRY_RUN sessions, the backtest on the page, a written risk decision). Read once at
# process start by baskfy_worker.settings / baskfy_api.settings / the desk's config.py;
# never a form field.
BASKFY_SWING_EXECUTION_ENABLED=false                                          # system-only
BASKFY_SWING_MONITOR_ENABLED=false                                            # system-only
BASKFY_SWING_EP_PREMARKET_ENABLED=false                                       # system-only
# The M4.1 boundary for the swing book: these are CEILINGS. The values a person actually
# trades with live in sw_config (user-editable in the app, validated <= the ceiling, audited).
# A ceiling in a form is privilege escalation; docs/03 §3f applies here exactly as it does to
# RISK_MAX_DAILY_LOSS_PCT.
# The numbers are his (docs/swing/07): risk "rarely more than 1%"; "never more than 30% of
# your account over night in any stock"; "15-20 positions in a good market". The defaults a
# person starts from (0.5% / 20% / 10) sit well inside them.
BASKFY_SWING_RISK_PER_TRADE_PCT_MAX=1.0                                       # system-only
BASKFY_SWING_MAX_POSITION_PCT_MAX=30.0                                        # system-only
BASKFY_SWING_MAX_OPEN_POSITIONS_MAX=20                                        # system-only
# The benchmark the market gate reads (docs/swing/04 §8.2); falls back to nifty-50 when absent.
BASKFY_SWING_INDEX_SLUG=nifty-500                                             # system-only
BASKFY_SWING_TIMING_PROBE=false                                               # system-only
BASKFY_SWING_TIMING_PROBE_DIR=docs/swing/status                               # system-only

# --- Volume breakout, the third sleeve (docs/vbt) ------------------------------------
# VBT-1: a 6.5%+ day on 3x its 50-day volume, in an uptrend, in a liquid name, bid at that
# day's close for three sessions, stopped 12% below the fill, sold at the next open on the
# first close under the 21-day EMA — and no new entry unless more than 40% of the traded
# universe is above its own 200-day average. docs/vbt/01 is the method; the research note is
# research/volume-breakout/STRATEGY.md.
#
# EXECUTION is Track B (docs/vbt/02): the code behind it is written, tested and unreachable.
# It flips only after the §3 gate — TWENTY DRY_RUN sessions, VB10 green, the backtest on the
# page, a written risk decision, half risk for the first five live sessions. The swing
# sleeve's delegation of its own flag does NOT extend to this one (DECISIONS-VB PACK.7).
#
# THERE IS NO AUTO-EXECUTE FLAG FOR THIS SLEEVE AND NONE IS ADDED. Non-negotiable 1's named
# exception belongs to the swing book, by Maulik's hand. A VBT order exists only because a
# person pressed Confirm on an unexpired plan.
BASKFY_VBT_EXECUTION_ENABLED=false                                            # system-only
# Detection moves no money, so the nightly step and its 21:00 retry are ON. Set false to
# silence them without removing them.
BASKFY_VBT_NIGHTLY_ENABLED=true                                               # system-only
# The M4.1 boundary for this sleeve: CEILINGS, never form fields. The values a person trades
# with live in vb_config (user-editable, validated <= the ceiling, audited). The strategy's
# own numbers — ten slots, 12.5% a position, a 12% stop — sit inside them; the ceilings leave
# room to lower the book, never to widen it into a different instrument.
BASKFY_VBT_MAX_OPEN_POSITIONS_MAX=15                                          # system-only
BASKFY_VBT_MAX_POSITION_PCT_MAX=15.0                                          # system-only
BASKFY_VBT_STOP_PCT_MAX=15.0                                                  # system-only

# --- Three weeks tight, the fourth sleeve (docs/twt) ---------------------------------
# TWT-1: a name whose last three weekly closes sit inside a 3.01% range, 30% above its
# three-months-back monthly low, above a 10,000-share 50-day volume average, entered at the
# NEXT OPEN at market on the first day of that state after five sessions out of it, stopped
# 20% below the fill and trailed 20% under the highest high since entry — and no new entry
# unless more than 40% of the traded universe is above its own 200-day average. docs/twt/01
# is the method; the research note is research/tight-close/STRATEGY.md.
#
# EXECUTION is Track B (docs/twt/02): the code behind it is written, tested and unreachable.
# It flips only after the §3 gate — TW10 green, both trees green, the backtest on the page,
# FIRST-LIVE-MORNING.md written, and MAULIK'S OWN HAND. The swing sleeve's delegation of its
# own flag does NOT extend to this one, and neither does VBT-1's.
#
# THERE IS NO AUTO-EXECUTE FLAG FOR THIS SLEEVE AND NONE IS ADDED. Non-negotiable 1's named
# exception belongs to the swing book, by Maulik's hand. A TWT order exists only because a
# person pressed Confirm on an unexpired plan — including the ratchet, which will want to
# fire on ten lines a night for months and is still a line somebody confirms.
BASKFY_TWT_EXECUTION_ENABLED=false                                            # system-only
# Detection moves no money, so the nightly step and its 21:00 retry are ON. Set false to
# silence them without removing them.
BASKFY_TWT_NIGHTLY_ENABLED=true                                               # system-only
# The M4.1 boundary for this sleeve: server bounds, never form fields. The values a person
# trades with live in tw_config (user-editable, validated against these, audited). The
# strategy's own numbers — ten slots, 12.5% a position, a 20% stop, a 20% trail — sit inside
# them.
BASKFY_TWT_MAX_OPEN_POSITIONS_MAX=15                                          # system-only
BASKFY_TWT_MAX_POSITION_PCT_MAX=15.00                                         # system-only
BASKFY_TWT_STOP_PCT_MAX=25.00                                                 # system-only
# AND THIS ONE IS A FLOOR, NOT A CEILING — note the _MIN. The trail is TWT-1's only exit
# (137 of the research's 164 exits) and the measured cliff is in the TIGHTENING direction:
# 20% -> 15% took the CAGR from 20.9% to 9.6% and the drawdown from -24.7% to -43%. Widening
# the trail is merely unprofitable; tightening it is the failure mode, so the bound that
# matters is a minimum. A value BELOW this is refused. DECISIONS-TW TW0.5.
BASKFY_TWT_TRAIL_PCT_MIN=18.00                                                # system-only
#
# tw_config.sleeve_capital_inr has NO bound and is NOT an environment variable: it is the
# person's own money, it is seeded at 0, and a sleeve at 0 plans nothing. Maulik enters it
# himself on the first live morning (docs/twt/02 §3).

# --- Condor (docs/condor) -----------------------------------------------------------
# One range-filtered, fully hedged NIFTY monthly-expiry iron condor (docs/condor/01). A REAL
# condor order needs FOUR switches at once — DRY_RUN=false, OPTIONS_ENABLED=true (NFO),
# INTRADAY_ENABLED=true (MIS), and the EXECUTION flag below — ANDed by condor_gates(); with
# any one false the desk simulates and journals simulated=true. All stay false until Maulik's
# hand after docs/condor/02 §3 (OC10 green, six paper expiries, the backtest tiers on the
# page, a written risk decision). Read once at process start; never a form field.
BASKFY_CONDOR_EXECUTION_ENABLED=false                                         # system-only
BASKFY_CONDOR_MONITOR_ENABLED=false                                           # system-only
BASKFY_CONDOR_CHAIN_COLLECT_ENABLED=false                                     # system-only
BASKFY_CONDOR_BANKNIFTY_ENABLED=false                                         # system-only
# CEILINGS (the M4.1 boundary). What a person trades with lives in oc_config, validated <= these.
# The method's numbers: max loss per expiry Rs 20-25k, absolute ceiling Rs 50k or 0.5% of the
# account, emergency daily Rs 30k, monthly pause Rs 75k, hard exit 14:30 (docs/condor/01 §6).
BASKFY_CONDOR_RISK_PER_EXPIRY_INR_MAX=50000                                   # system-only
BASKFY_CONDOR_RISK_PCT_MAX=0.5                                                # system-only
BASKFY_CONDOR_MAX_LOTS_MAX=10                                                 # system-only
BASKFY_CONDOR_DAILY_LOSS_INR_MAX=30000                                        # system-only
BASKFY_CONDOR_MONTHLY_LOSS_INR_MAX=75000                                      # system-only
BASKFY_CONDOR_HARD_EXIT_LATEST=14:30                                          # system-only

# SW18 (docs/swing/DECISIONS-SW SW18.1): the morning Kite login nudge. At 08:45 and again at
# 09:05 IST on weekdays the worker checks for a usable Kite access token for the day and, when
# there is none, emails ONE login link. No password and no TOTP seed live on the box — the link
# opens Zerodha's own page and the existing /api/v1/brokers/callback stores the token.
# With _TO unset the job logs and does nothing. Needs BASKFY_SOLE_USER_ID, BASKFY_KITE_API_KEY
# and BASKFY_BROKER_OAUTH_STATE_PATH (the state file the API's callback reads back).
BASKFY_KITE_LOGIN_NUDGE_ENABLED=false                                         # system-only
BASKFY_KITE_LOGIN_NUDGE_TO=                                                   # system-only

# --- Email (Prompt 12) ------------------------------------------------------
BASKFY_RESEND_API_KEY=                                                        # system-only

# --- Auth (docs/07, docs/11 §Security) --------------------------------------
# HS256 shared secret between apps/web (Auth.js) and services/api (docs/03). The API verifies
# tokens; apps/web issues them (Prompt 12). RFC 7518 §3.2 requires at least 32 bytes for HS256,
# and `BASKFY_ENVIRONMENT=production` refuses to start with anything shorter.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BASKFY_JWT_SECRET=                                                            # system-only
# Optional; when set, a token whose `iss`/`aud` do not match is refused.
BASKFY_JWT_ISSUER=                                                            # system-only
BASKFY_JWT_AUDIENCE=                                                          # system-only
# docs/11: "15-min access". A correctly signed token with a longer lifetime is still refused.
BASKFY_JWT_MAX_LIFETIME_SECONDS=900                                           # system-only

# --- API service (Prompt 7) -------------------------------------------------
# local | test | staging | production. `production` enforces the checks in Settings.require_configured.
BASKFY_ENVIRONMENT=local                                                      # system-only
# docs/07 §Conventions. The API-key tier is unreachable until Prompt 20 issues keys.
BASKFY_RATE_LIMIT_ANONYMOUS_PER_MINUTE=10                                     # system-only
BASKFY_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60                                 # system-only
BASKFY_RATE_LIMIT_API_KEY_PER_MINUTE=600                                      # system-only
BASKFY_RATE_LIMIT_ENABLED=true                                                # system-only
# Comma-separated; the Next.js dev server by default.
BASKFY_CORS_ORIGINS=["http://localhost:3000"]                                 # system-only

# --- Observability (docs/02 §Observability) ---------------------------------
BASKFY_LOG_LEVEL=INFO                                                         # system-only
# false gives human-readable lines; true gives one JSON object per line for Loki.
BASKFY_LOG_JSON=false                                                         # system-only
BASKFY_OTEL_ENABLED=false                                                     # system-only
BASKFY_OTEL_SERVICE_NAME=baskfy-api                                           # system-only
# Leave empty with OTEL enabled to create spans and drop them (useful in tests).
BASKFY_OTEL_EXPORTER_OTLP_ENDPOINT=                                           # system-only

# --- Web (apps/web, Prompt 8) -----------------------------------------------
# The API origin. The /api/v1 prefix is stripped by the client, so either form works.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1                              # system-only
# Canonical site origin, used for metadata, robots.txt and the sitemap (docs/14).
NEXT_PUBLIC_SITE_URL=https://baskfy.com                                       # system-only
# Operator desk console (plan hand-off links). Required in production/staging — no silent fallback.
NEXT_PUBLIC_DESK_URL=https://desk.modelbasket.in                              # system-only
# Shared secret for POST /api/revalidate. Required in production.
REVALIDATE_SECRET=                                                            # system-only
# Auth.js's own cookie-encryption secret. Separate from BASKFY_JWT_SECRET, which is the shared
# secret the API verifies bearer tokens with — they are different keys for different jobs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=                                                                  # system-only
# The same database as BASKFY_DATABASE_URL, without SQLAlchemy's `+asyncpg` driver suffix —
# `pg` is a plain PostgreSQL client and does not understand it.
BASKFY_DATABASE_URL_PG=postgresql://baskfy:baskfy@localhost:5433/baskfy       # system-only

# --- Observability (Prompt 17; docs/02 §Observability) ----------------------
# OpenTelemetry. Off by default: tracing on a laptop costs latency and produces spans nobody
# reads. On with no endpoint = spans created and dropped, which is what the tests want.
BASKFY_OTEL_ENABLED=false                                                     # system-only
BASKFY_OTEL_EXPORTER_OTLP_ENDPOINT=                                           # system-only
BASKFY_OTEL_SERVICE_NAME=baskfy-api                                           # system-only

# Sentry. EMPTY MEANS THE SDK IS NEVER INITIALISED — see services/api/src/baskfy_api/sentry.py
# for why that is the honest default rather than a no-op init. The web app reads SENTRY_DSN
# (unprefixed) from apps/web/src/instrumentation.ts; server-side only, no client bundle.
BASKFY_SENTRY_DSN=                                                            # system-only
SENTRY_DSN=                                                                   # system-only
BASKFY_SENTRY_SAMPLE_RATE=1.0                                                 # system-only
# The build this process is running (a git sha). Tags Sentry events and OTel resources.
BASKFY_RELEASE=                                                               # system-only

# Prometheus. `/metrics` sits outside /api/v1 and is unauthenticated unless a token is set —
# correct on a private network, wrong on the public internet.
BASKFY_METRICS_ENABLED=true                                                   # system-only
BASKFY_METRICS_TOKEN=                                                         # system-only
# Each Celery worker process serves its own exposition on this port.
BASKFY_WORKER_METRICS_PORT=9101                                               # system-only

# --- Alerting (Prompt 17 deliverable 3) -------------------------------------
# All three empty is a valid deployment — a laptop — and is also the state in which nobody is
# woken up. `baskfy_worker.alerts.dispatch` says so once per process.
BASKFY_OPS_ALERT_EMAIL=                                                       # system-only
BASKFY_OPS_ALERT_WEBHOOK_URL=                                                 # system-only
# docs/11 §Reliability: "data published by 20:15 IST on >=95% of trading days."
BASKFY_PUBLISH_DEADLINE_IST=20:15                                             # system-only
# A run still `running` this long after it started is treated as abandoned. Above docs/11's
# 45-minute end-to-end budget, so a healthy slow night is never reaped.
BASKFY_PIPELINE_STALE_AFTER_MINUTES=90                                        # system-only
BASKFY_QUEUE_BACKLOG_THRESHOLD=100                                            # system-only
BASKFY_KITE_TOKEN_WARNING_HOURS=6                                             # system-only

# --- Backups (Prompt 17 deliverable 6; docs/11 §Reliability) ----------------
# Empty bucket = local-only dumps, which is what CI and a laptop use.
BASKFY_BACKUP_S3_BUCKET=                                                      # system-only
BASKFY_BACKUP_S3_PREFIX=pg                                                    # system-only
BASKFY_BACKUP_DIR=.backups                                                    # system-only
BASKFY_BACKUP_RETENTION_DAYS=7                                                # system-only

# --- Public API, alerts and webhooks (Prompt 20) ----------------------------
# Where a caller of the public API is told to write; appears in the terms-of-use document.
BASKFY_PUBLIC_API_CONTACT_EMAIL=api@baskfy.com                                # system-only
# The base URL printed in the interactive reference's copy-paste examples.
BASKFY_PUBLIC_API_BASE_URL=http://localhost:8000                              # system-only
# Redoc, pinned by version. An air-gapped deployment can point this at a self-hosted copy.
# There is no Subresource Integrity hash — see docs/DECISIONS.md §20.8.
BASKFY_REDOC_SCRIPT_URL=https://cdn.redoc.ly/redoc/v2.5.0/bundles/redoc.standalone.js # system-only
# The master an outbound webhook's per-endpoint signing secret is derived from, and the same
# master the unsubscribe links in alert emails are signed with. Empty falls back to
# BASKFY_JWT_SECRET. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BASKFY_WEBHOOK_SIGNING_SECRET=                                                # system-only


# ======================================================================================
# THE EXECUTION DESK — kite-momentum-rebalancer/.env
#
# Unprefixed by design until M15+. This is the file the live Mumbai box reads.
# ======================================================================================

# Copy to .env and fill in. Every setting the code reads is listed here; anything you
# leave out falls back to the default shown.
#
# MOST OF THESE ARE ALSO EDITABLE AT http://127.0.0.1:8420/settings, which stores an
# override in the database that BEATS this file and applies without a restart. This file
# stays the bootstrap and the fallback; reset an override there to hand a setting back.
# Editing here still requires a restart, and a database override will mask the change.
#
# NOT editable from the interface, deliberately: the credentials below, and DRY_RUN /
# INTRADAY_ENABLED / OPTIONS_ENABLED. Enabling live orders should be an act on the
# machine that runs the system, not a click in a browser.
#
# Inline comments are stripped, but a trailing space is NOT: write DRY_RUN=false, never
# "DRY_RUN=false " — the latter silently keeps simulation on.

# ---- Kite Connect ---------------------------------------------------------------------
# Create an app at https://developers.kite.trade (Rs 2000/mo subscription).
# Set the app's Redirect URL to exactly: http://127.0.0.1:8420/callback
KITE_API_KEY=your_api_key                                                     # system-only
KITE_API_SECRET=your_api_secret                                               # system-only
PORT=8420                                                                     # system-only
TOKEN_FILE=data/.kite_token.json      # access token cache; expires daily (~6am IST) # system-only

# ---- SAFETY ---------------------------------------------------------------------------
# The global no-order guarantee. While true, /execute simulates: no order reaches the
# broker, no regime policy tier is committed, no rebalance is marked executed. Market-data
# caching still runs. Keep true until the plan output looks right for 2-3 sessions.
DRY_RUN=true                                                                  # system-only

# Leave the machine on IPv4 for every broker call. Kite authorises order placement against
# an allowlist of IP addresses; this connection offers both families and prefers IPv6, so
# on 19 Aug 2026 a whole rebalance was refused for an address (a rotating residential v6
# prefix) that cannot usefully be allowlisted, while the v4 address sat in the console.
# Set false only on a host whose IPv6 address is itself static and allowlisted.
FORCE_IPV4=true                                                               # system-only

# --- interface security ---------------------------------------------------------------
# The desk places real orders and is reached over an SSH tunnel, so it binds to loopback
# and answers only to these names. A request arriving as anything else is how a browser is
# tricked into treating this app as an attacker's own site (DNS rebinding), so it is
# refused before it routes.
DESK_ALLOWED_HOSTS=127.0.0.1,localhost,testserver                             # system-only
DESK_PORT=8420                                                                # system-only

# SET THIS ON ANY HOSTED OR SHARED BOX. Loopback is not a boundary between users of the
# same machine: without a password every route here is reachable by anything on the host
# that can open a socket. Empty is correct for a personal laptop and nothing else.
# Any username works; the password is what is checked.
DESK_PASSWORD=                                                                # system-only

# The interactive API docs enumerate every route, including the ones that place orders.
DESK_DOCS=false                                                               # system-only

# The swing notifier (SW11, docs/swing/STANDING-ANSWERS A2): a TRIGGERED signal for a
# daily-focus name is emailed with the whole line through this stdlib SMTP sender, one-way
# (a reply cannot reach an order); blank host = no email. Telegram is scaffolded dark: the
# sender exists only when BOTH are set, sends one message per signal, reads nothing back.
DESK_SMTP_HOST=                                                               # system-only
DESK_SMTP_PORT=587                                                            # system-only
DESK_SMTP_USER=                                                               # system-only
DESK_SMTP_PASSWORD=                                                           # system-only
DESK_SMTP_STARTTLS=true                                                       # system-only
DESK_NOTIFY_FROM=                                                             # system-only
DESK_NOTIFY_TO=                                                               # system-only
BASKFY_SWING_TELEGRAM_BOT_TOKEN=                                              # system-only
BASKFY_SWING_TELEGRAM_CHAT_ID=                                                # system-only
# The swing monitor process exports its own metrics on this port when METRICS_PORT is set;
# blank = METRICS_PORT + 1 (two processes cannot share one listener).
DESK_MONITOR_METRICS_PORT=                                                    # system-only

# Product gates, enforced inside core/gateway.py before any order. The rebalancer is
# CNC-only; leave both false unless you are deliberately enabling those engines.
INTRADAY_ENABLED=false                # MIS / intraday                        # system-only
OPTIONS_ENABLED=false                 # NFO / BFO                             # system-only

# Option strategy research settings. These affect planning only; the two product gates
# above and DRY_RUN still decide whether an order can reach the broker.
OPTION_UNDERLYING=NIFTY                                                       # system-only
OPTION_INTRADAY_SQUARE_OFF=15:12                                              # system-only
OPTION_SELL_MONTHLY_BENCHMARK_PCT=5.0 # benchmark, not a guaranteed or forced return # system-only
OPTION_SELL_ENTRY_START=09:45                                                 # system-only
OPTION_SELL_ENTRY_END=13:30                                                   # system-only
OPTION_SELL_RISK_PER_TRADE_PCT=0.75                                           # system-only
OPTION_SELL_SHORT_DELTA=0.16                                                  # system-only
OPTION_SELL_WING_DELTA=0.05                                                   # system-only
OPTION_SELL_TARGET_CAPTURE_PCT=35                                             # system-only
OPTION_SELL_STOP_CREDIT_MULTIPLE=1.5                                          # system-only
OPTION_BUY_TRADE_BENCHMARK_PCT=15.0    # activates trailing profit management # system-only
OPTION_BUY_ENTRY_START=09:35                                                  # system-only
OPTION_BUY_ENTRY_END=14:30                                                    # system-only
OPTION_BUY_RISK_PER_TRADE_PCT=0.50                                            # system-only
OPTION_BUY_DELTA=0.60                                                         # system-only
OPTION_BUY_PREMIUM_STOP_PCT=25                                                # system-only
OPTION_BUY_TRAIL_ACTIVATION_PCT=15                                            # system-only
OPTION_BUY_TRAIL_DRAWDOWN_PCT=8                                               # system-only

# ---- Risk limits ----------------------------------------------------------------------
# Enforced on every order by core/risk.py. Leave the two rupee caps BLANK to derive them
# from live NAV, so they cannot contradict the strategy's own sizing as the book grows:
# a fixed cap of Rs 15L silently forbade the Rs 15.8L position MAX_SINGLE_WEIGHT allows.
RISK_MAX_POSITION_VALUE=              # blank = MAX_SINGLE_WEIGHT% of NAV x headroom # system-only
RISK_MAX_GROSS_EXPOSURE=              # blank = NAV x RISK_GROSS_MULTIPLE     # system-only
RISK_POSITION_HEADROOM=1.25           # room for price movement between plan and fill # system-only
RISK_GROSS_MULTIPLE=1.5                                                       # system-only
RISK_MAX_DAILY_LOSS_PCT=5.0           # kill switch: halts trading for the day at this loss # system-only
RISK_MAX_ORDERS_PER_DAY=500           # our own cap, well under Kite's 3000   # system-only

# ---- Portfolio ------------------------------------------------------------------------
FULLY_INVESTED=false                  # true = ignore the breadth-driven cash bands # user-editable
DB_PATH=data/portfolio.db             # SQLite: snapshots, benchmarks, regime, trades # system-only
# Untouchable instruments (SGB/G-sec) are recorded in every snapshot but kept OUT of
# nav/invested, so their P&L is not attributed to the momentum strategy. Set true to
# track total account value instead.
INCLUDE_UNTOUCHABLE_IN_NAV=false                                              # user-editable

# ---- Tax lots -------------------------------------------------------------------------
# There is no historical tradebook API, so FIFO lots come from a Console export:
#   console.zerodha.com -> Reports -> Tradebook -> download CSV
#   python -m app.analytics.tradebook --file data/uploads/tradebook.csv --reconcile
# Until that is imported, every tax review returns TAX_DATA_UNKNOWN and requires manual
# review, which is the correct fail-safe: no sale is ever assumed tax-safe.

# ---- Regime overlay -------------------------------------------------------------------
# Three independent switches. REGIME_ENABLED is the feature; REGIME_MODE is how far a
# decision may travel; DRY_RUN above still overrides everything.
REGIME_ENABLED=false                  # master switch for the overlay         # user-editable
REGIME_MODE=observe                   # observe | propose | enforce           # user-editable
#   observe  calculate and display only, no executable plan
#   propose  build a plan for review; it runs only on explicit approval
#   enforce  an approved plan may be sent through the order gateway

# Signal shape
REGIME_BUFFER_BPS=150                 # Schmitt-trigger band around each MA (150 = 1.50%) # user-editable
REGIME_CONFIRM_DAYS=3                 # consecutive closes needed to confirm a side # user-editable
REGIME_WEEKLY_EVAL_WEEKDAY=4          # 0=Mon .. 4=Fri                        # user-editable

# Data quality. Degraded inputs may block new buys but never force selling on their own.
REGIME_INDEX_STALE_DAYS=5             # index candles older than this are stale # user-editable
REGIME_BREADTH_STALE_DAYS=10                                                  # user-editable
REGIME_MIN_BREADTH_COVERAGE_PCT=90    # below this, breadth cannot force or permit anything # user-editable

# Exposure and sizing
REGIME_R4_EQUITY_PCT=10               # R4 cap. Set 0 for genuine full cash.  # system-only
REGIME_R4_MAX_RESIDUAL_NAMES=2        # 0 forces R4 to full cash rather than inventing names # system-only
REGIME_R4_RESIDUAL_ORDERING=rank,liquidity                                    # system-only
REGIME_HALF_SIZE_FACTOR=0.5           # R2 provisional entries, as a fraction of full size # user-editable
REGIME_NEARBY_RANK_BAND=3             # rank band within which losers are sold before winners # user-editable

# Policy
REGIME_BOOTSTRAP_POLICY=observe_only  # observe_only | adopt_candidate        # user-editable
#   observe_only never generates forced sells merely because no prior state exists
REGIME_LTCG_REVIEW_DAYS=45            # flag a profitable lot this close to long-term # user-editable

# --- Google sign-in (M46; the only way in) ----------------------------------
# From the Google Cloud console, project `baskfy`, Web application OAuth client.
# Authorized redirect URIs must include:
#   https://staging.baskfy.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# The web app needs BOTH (it runs the OAuth exchange). The API needs the CLIENT ID only, and uses
# it as the `aud` it will accept on a Google ID token — that check is what stops a token minted
# for somebody else's Google app from signing that person in, so it is not optional.
BASKFY_GOOGLE_CLIENT_ID=
BASKFY_GOOGLE_CLIENT_SECRET=
