# Copy to .env and fill in. Every setting the code reads is listed here; anything you
# leave out falls back to the default shown.
#
# MOST OF THESE ARE ALSO EDITABLE AT http://127.0.0.1:8420/settings, which stores an
# override in the database that BEATS this file and applies without a restart. This file
# stays the bootstrap and the fallback; reset an override there to hand a setting back.
# Editing here still requires a restart, and a database override will mask the change.
#
# NOT editable from the interface, deliberately: the credentials below, and DRY_RUN /
# INTRADAY_ENABLED / OPTIONS_ENABLED. Enabling live orders should be an act on the
# machine that runs the system, not a click in a browser.
#
# Inline comments are stripped, but a trailing space is NOT: write DRY_RUN=false, never
# "DRY_RUN=false " — the latter silently keeps simulation on.

# ---- Kite Connect ---------------------------------------------------------------------
# Create an app at https://developers.kite.trade (Rs 2000/mo subscription).
# Set the app's Redirect URL to exactly: http://127.0.0.1:8420/callback
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
PORT=8420
TOKEN_FILE=data/.kite_token.json      # access token cache; expires daily (~6am IST)

# ---- SAFETY ---------------------------------------------------------------------------
# The global no-order guarantee. While true, /execute simulates: no order reaches the
# broker, no regime policy tier is committed, no rebalance is marked executed. Market-data
# caching still runs. Keep true until the plan output looks right for 2-3 sessions.
DRY_RUN=true

# Product gates, enforced inside core/gateway.py before any order. The rebalancer is
# CNC-only; leave both false unless you are deliberately enabling those engines.
INTRADAY_ENABLED=false                # MIS / intraday
OPTIONS_ENABLED=false                 # NFO / BFO

# ---- Risk limits ----------------------------------------------------------------------
# Enforced on every order by core/risk.py. Leave the two rupee caps BLANK to derive them
# from live NAV, so they cannot contradict the strategy's own sizing as the book grows:
# a fixed cap of Rs 15L silently forbade the Rs 15.8L position MAX_SINGLE_WEIGHT allows.
RISK_MAX_POSITION_VALUE=              # blank = MAX_SINGLE_WEIGHT% of NAV x headroom
RISK_MAX_GROSS_EXPOSURE=              # blank = NAV x RISK_GROSS_MULTIPLE
RISK_POSITION_HEADROOM=1.25           # room for price movement between plan and fill
RISK_GROSS_MULTIPLE=1.5
RISK_MAX_DAILY_LOSS_PCT=5.0           # kill switch: halts trading for the day at this loss
RISK_MAX_ORDERS_PER_DAY=500           # our own cap, well under Kite's 3000

# ---- Portfolio ------------------------------------------------------------------------
FULLY_INVESTED=false                  # true = ignore the breadth-driven cash bands
DB_PATH=data/portfolio.db             # SQLite: snapshots, benchmarks, regime, trades
# Untouchable instruments (SGB/G-sec) are recorded in every snapshot but kept OUT of
# nav/invested, so their P&L is not attributed to the momentum strategy. Set true to
# track total account value instead.
INCLUDE_UNTOUCHABLE_IN_NAV=false

# ---- Tax lots -------------------------------------------------------------------------
# There is no historical tradebook API, so FIFO lots come from a Console export:
#   console.zerodha.com -> Reports -> Tradebook -> download CSV
#   python -m app.analytics.tradebook --file data/uploads/tradebook.csv --reconcile
# Until that is imported, every tax review returns TAX_DATA_UNKNOWN and requires manual
# review, which is the correct fail-safe: no sale is ever assumed tax-safe.

# ---- Regime overlay -------------------------------------------------------------------
# Three independent switches. REGIME_ENABLED is the feature; REGIME_MODE is how far a
# decision may travel; DRY_RUN above still overrides everything.
REGIME_ENABLED=false                  # master switch for the overlay
REGIME_MODE=observe                   # observe | propose | enforce
#   observe  calculate and display only, no executable plan
#   propose  build a plan for review; it runs only on explicit approval
#   enforce  an approved plan may be sent through the order gateway

# Signal shape
REGIME_BUFFER_BPS=150                 # Schmitt-trigger band around each MA (150 = 1.50%)
REGIME_CONFIRM_DAYS=3                 # consecutive closes needed to confirm a side
REGIME_WEEKLY_EVAL_WEEKDAY=4          # 0=Mon .. 4=Fri

# Data quality. Degraded inputs may block new buys but never force selling on their own.
REGIME_INDEX_STALE_DAYS=5             # index candles older than this are stale
REGIME_BREADTH_STALE_DAYS=10
REGIME_MIN_BREADTH_COVERAGE_PCT=90    # below this, breadth cannot force or permit anything

# Exposure and sizing
REGIME_R4_EQUITY_PCT=10               # R4 cap. Set 0 for genuine full cash.
REGIME_R4_MAX_RESIDUAL_NAMES=2        # 0 forces R4 to full cash rather than inventing names
REGIME_R4_RESIDUAL_ORDERING=rank,liquidity
REGIME_HALF_SIZE_FACTOR=0.5           # R2 provisional entries, as a fraction of full size
REGIME_NEARBY_RANK_BAND=3             # rank band within which losers are sold before winners

# Policy
REGIME_BOOTSTRAP_POLICY=observe_only  # observe_only | adopt_candidate
#   observe_only never generates forced sells merely because no prior state exists
REGIME_LTCG_REVIEW_DAYS=45            # flag a profitable lot this close to long-term
