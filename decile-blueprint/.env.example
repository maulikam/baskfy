# Baskfy — environment template. Copy to .env and fill in. NEVER commit real secrets.
# Env prefix is BASKFY_ for application settings (docs/14-brand-and-naming.md).

# --- Database ---------------------------------------------------------------
# Async driver for the app; Alembic uses the same URL.
BASKFY_DATABASE_URL=postgresql+asyncpg://baskfy:baskfy@localhost:5433/baskfy
# Port the compose stack publishes Postgres on (see infra/docker/compose.yml).
BASKFY_POSTGRES_PORT=5433

# Database used by the `db`-marked pytest suite. Left unset -> those tests skip.
BASKFY_TEST_DATABASE_URL=postgresql+asyncpg://baskfy:baskfy@localhost:5433/baskfy_test

# --- Cache / broker ---------------------------------------------------------
BASKFY_REDIS_URL=redis://localhost:6380/0
BASKFY_REDIS_PORT=6380

# --- Providers --------------------------------------------------------------
BASKFY_KITE_API_KEY=
BASKFY_KITE_API_SECRET=
# Fernet key encrypting the daily Kite access token at rest (docs/11 §Security).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BASKFY_KITE_TOKEN_ENCRYPTION_KEY=
BASKFY_KITE_TOKEN_PATH=.secrets/kite-token.enc
# docs/09: Kite allows ~3 req/s; day-interval history chunks into <=2000-day slices.
BASKFY_KITE_RATE_LIMIT_PER_SECOND=3
BASKFY_KITE_MAX_DAYS_PER_REQUEST=2000
BASKFY_KITE_MAX_CONCURRENCY=3

# NSE public files are rate-sensitive (docs/09 §"NSE specifics").
BASKFY_NSE_RATE_LIMIT_PER_SECOND=1
BASKFY_NSE_REQUEST_TIMEOUT_SECONDS=30

# Retry and circuit-breaker budgets shared by every provider.
BASKFY_PROVIDER_MAX_ATTEMPTS=5
BASKFY_PROVIDER_BACKOFF_BASE_SECONDS=0.5
BASKFY_PROVIDER_BACKOFF_MAX_SECONDS=30
BASKFY_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
BASKFY_PROVIDER_CIRCUIT_RESET_SECONDS=60

# --- Object storage (Prompt 2+) ---------------------------------------------
BASKFY_S3_ENDPOINT_URL=
BASKFY_S3_REGION=auto
BASKFY_S3_BUCKET=baskfy-local
BASKFY_S3_ACCESS_KEY_ID=
BASKFY_S3_SECRET_ACCESS_KEY=

# --- Payments (docs/02 §Payments: Razorpay; Prompt 13) ----------------------
# Use TEST-mode credentials everywhere but production. `BASKFY_ENVIRONMENT=production` refuses to
# start without the key pair and the webhook secret (docs/11 §Security: "verify signature").
BASKFY_RAZORPAY_KEY_ID=
BASKFY_RAZORPAY_KEY_SECRET=
# NOT the key secret. Razorpay signs a webhook with the value configured on the webhook itself.
BASKFY_RAZORPAY_WEBHOOK_SECRET=
# Razorpay subscriptions bill against a plan created in *their* dashboard, which has its own id.
# Environment-specific (test vs live), so it is configuration rather than seed data.
BASKFY_RAZORPAY_PLAN_ID_MONTHLY=
BASKFY_RAZORPAY_PLAN_ID_YEARLY=

# --- GST invoicing (docs/11 §"Compliance & legal (India)"; Prompt 13) -------
# ⚠️ The rate and the SAC below are defaults, NOT advice. A chartered accountant must confirm both
# before the first real charge — see docs/DECISIONS.md §13.2.
BASKFY_GST_RATE_PERCENT=18
BASKFY_GST_SAC_CODE=998439
# The supplier's own particulars. Every one of them is printed on the invoice.
BASKFY_SUPPLIER_LEGAL_NAME=Baskfy
# A JSON list, e.g. ["12 MG Road","Bengaluru 560001"]
BASKFY_SUPPLIER_ADDRESS_LINES=[]
BASKFY_SUPPLIER_GSTIN=
# Spelled as the GST return expects it, e.g. "Karnataka (29)". Also the default place of supply
# for a customer whose own state we do not hold (IGST Act §12(2)(b)).
BASKFY_SUPPLIER_STATE=
# Invoice numbers are DCL/2026-27/000001 — prefix / financial year / gapless running number.
BASKFY_INVOICE_SERIES_PREFIX=DCL
# Where invoice PDFs go when no S3/R2 bucket is configured above.
BASKFY_INVOICE_LOCAL_DIR=.archive

# --- Feature flags (docs/11 §Reliability: "anything touching money") --------
# PROMPTS.md Prompt 13 §5's optional ₹0 tier, limited to NIFTY 50. Off by default. Turning it on
# needs `make seed` re-run: the plan row is only created while the flag is set.
BASKFY_FREE_TIER_ENABLED=false
# PROMPTS.md Prompt 20 §2's public read API. **OFF, and it must stay off.** docs/11 §Compliance:
# "Get a written data-redistribution opinion before enabling the public API tier." Setting this to
# true is NOT sufficient and NOT permission — the router also refuses to mount until
# `baskfy_core.public_api.DATA_REDISTRIBUTION_REVIEW.signed_off` is flipped in source, which is a
# reviewable commit. See docs/DECISIONS.md §20.1.
BASKFY_PUBLIC_API_ENABLED=false

# --- Swing (docs/swing) -----------------------------------------------------
# The swing book's three Track-B flags (docs/swing/02): built dark, default off, tests assert
# unreachability. EXECUTION flips only by Maulik's hand after the §3 gate. Read once at process
# start by baskfy_api.settings / baskfy_worker.settings; never a form field.
BASKFY_SWING_EXECUTION_ENABLED=false
BASKFY_SWING_MONITOR_ENABLED=false
BASKFY_SWING_EP_PREMARKET_ENABLED=false
# The M4.1 boundary for the swing book: these are CEILINGS. The values a person trades with
# live in sw_config (user-editable, validated <= the ceiling, audited). The numbers are his
# (docs/swing/07): risk "rarely more than 1%"; "never more than 30% of your account over night
# in any stock"; "15-20 positions in a good market".
BASKFY_SWING_RISK_PER_TRADE_PCT_MAX=1.0
BASKFY_SWING_MAX_POSITION_PCT_MAX=30.0
BASKFY_SWING_MAX_OPEN_POSITIONS_MAX=20
# The benchmark the market gate reads (docs/swing/04 §8.2); falls back to nifty-50 when absent.
BASKFY_SWING_INDEX_SLUG=nifty-500

# --- Email (Prompt 12) ------------------------------------------------------
BASKFY_RESEND_API_KEY=

# --- Auth (docs/07, docs/11 §Security) --------------------------------------
# HS256 shared secret between apps/web (Auth.js) and services/api (docs/03). The API verifies
# tokens; apps/web issues them (Prompt 12). RFC 7518 §3.2 requires at least 32 bytes for HS256,
# and `BASKFY_ENVIRONMENT=production` refuses to start with anything shorter.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BASKFY_JWT_SECRET=
# Optional; when set, a token whose `iss`/`aud` do not match is refused.
BASKFY_JWT_ISSUER=
BASKFY_JWT_AUDIENCE=
# docs/11: "15-min access". A correctly signed token with a longer lifetime is still refused.
BASKFY_JWT_MAX_LIFETIME_SECONDS=900

# --- API service (Prompt 7) -------------------------------------------------
# local | test | staging | production. `production` enforces the checks in Settings.require_configured.
BASKFY_ENVIRONMENT=local
# docs/07 §Conventions. The API-key tier is unreachable until Prompt 20 issues keys.
BASKFY_RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
BASKFY_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60
BASKFY_RATE_LIMIT_API_KEY_PER_MINUTE=600
BASKFY_RATE_LIMIT_ENABLED=true
# Comma-separated; the Next.js dev server by default.
BASKFY_CORS_ORIGINS=["http://localhost:3000"]

# --- Observability (docs/02 §Observability) ---------------------------------
BASKFY_LOG_LEVEL=INFO
# false gives human-readable lines; true gives one JSON object per line for Loki.
BASKFY_LOG_JSON=false
BASKFY_OTEL_ENABLED=false
BASKFY_OTEL_SERVICE_NAME=baskfy-api
# Leave empty with OTEL enabled to create spans and drop them (useful in tests).
BASKFY_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web (apps/web, Prompt 8) -----------------------------------------------
# The API origin. The /api/v1 prefix is stripped by the client, so either form works.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Canonical site origin, used for metadata, robots.txt and the sitemap (docs/14).
NEXT_PUBLIC_SITE_URL=https://baskfy.com
# Auth.js's own cookie-encryption secret. Separate from BASKFY_JWT_SECRET, which is the shared
# secret the API verifies bearer tokens with — they are different keys for different jobs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# The same database as BASKFY_DATABASE_URL, without SQLAlchemy's `+asyncpg` driver suffix —
# `pg` is a plain PostgreSQL client and does not understand it.
BASKFY_DATABASE_URL_PG=postgresql://baskfy:baskfy@localhost:5433/baskfy

# --- Observability (Prompt 17; docs/02 §Observability) ----------------------
# OpenTelemetry. Off by default: tracing on a laptop costs latency and produces spans nobody
# reads. On with no endpoint = spans created and dropped, which is what the tests want.
BASKFY_OTEL_ENABLED=false
BASKFY_OTEL_EXPORTER_OTLP_ENDPOINT=
BASKFY_OTEL_SERVICE_NAME=baskfy-api

# Sentry. EMPTY MEANS THE SDK IS NEVER INITIALISED — see services/api/src/baskfy_api/sentry.py
# for why that is the honest default rather than a no-op init. The web app reads SENTRY_DSN
# (unprefixed) from apps/web/src/instrumentation.ts; server-side only, no client bundle.
BASKFY_SENTRY_DSN=
SENTRY_DSN=
BASKFY_SENTRY_SAMPLE_RATE=1.0
# The build this process is running (a git sha). Tags Sentry events and OTel resources.
BASKFY_RELEASE=

# Prometheus. `/metrics` sits outside /api/v1 and is unauthenticated unless a token is set —
# correct on a private network, wrong on the public internet.
BASKFY_METRICS_ENABLED=true
BASKFY_METRICS_TOKEN=
# Each Celery worker process serves its own exposition on this port.
BASKFY_WORKER_METRICS_PORT=9101

# --- Alerting (Prompt 17 deliverable 3) -------------------------------------
# All three empty is a valid deployment — a laptop — and is also the state in which nobody is
# woken up. `baskfy_worker.alerts.dispatch` says so once per process.
BASKFY_OPS_ALERT_EMAIL=
BASKFY_OPS_ALERT_WEBHOOK_URL=
# docs/11 §Reliability: "data published by 20:15 IST on >=95% of trading days."
BASKFY_PUBLISH_DEADLINE_IST=20:15
# A run still `running` this long after it started is treated as abandoned. Above docs/11's
# 45-minute end-to-end budget, so a healthy slow night is never reaped.
BASKFY_PIPELINE_STALE_AFTER_MINUTES=90
BASKFY_QUEUE_BACKLOG_THRESHOLD=100
BASKFY_KITE_TOKEN_WARNING_HOURS=6

# --- Backups (Prompt 17 deliverable 6; docs/11 §Reliability) ----------------
# Empty bucket = local-only dumps, which is what CI and a laptop use.
BASKFY_BACKUP_S3_BUCKET=
BASKFY_BACKUP_S3_PREFIX=pg
BASKFY_BACKUP_DIR=.backups
BASKFY_BACKUP_RETENTION_DAYS=7

# --- Public API, alerts and webhooks (Prompt 20) ----------------------------
# Where a caller of the public API is told to write; appears in the terms-of-use document.
BASKFY_PUBLIC_API_CONTACT_EMAIL=api@baskfy.com
# The base URL printed in the interactive reference's copy-paste examples.
BASKFY_PUBLIC_API_BASE_URL=http://localhost:8000
# Redoc, pinned by version. An air-gapped deployment can point this at a self-hosted copy.
# There is no Subresource Integrity hash — see docs/DECISIONS.md §20.8.
BASKFY_REDOC_SCRIPT_URL=https://cdn.redoc.ly/redoc/v2.5.0/bundles/redoc.standalone.js
# The master an outbound webhook's per-endpoint signing secret is derived from, and the same
# master the unsubscribe links in alert emails are signed with. Empty falls back to
# BASKFY_JWT_SECRET. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BASKFY_WEBHOOK_SIGNING_SECRET=

# --- Google sign-in (M46; the only way in) ----------------------------------
# From the Google Cloud console, project `baskfy`, Web application OAuth client.
# Authorized redirect URIs must include:
#   https://staging.baskfy.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# The web app needs BOTH (it runs the OAuth exchange). The API needs the CLIENT ID only, and uses
# it as the `aud` it will accept on a Google ID token — that check is what stops a token minted
# for somebody else's Google app from signing that person in, so it is not optional.
BASKFY_GOOGLE_CLIENT_ID=
BASKFY_GOOGLE_CLIENT_SECRET=
