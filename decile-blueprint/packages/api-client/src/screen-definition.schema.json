{
  "$defs": {
    "AwayFromHighFilter": {
      "additionalProperties": false,
      "description": "\"Within X% of high\". ``100`` means ignore (docs/01 §2.4).",
      "properties": {
        "ath": {
          "default": 100,
          "title": "Ath",
          "type": "integer"
        },
        "one_year": {
          "default": 100,
          "title": "One Year",
          "type": "integer"
        }
      },
      "title": "AwayFromHighFilter",
      "type": "object"
    },
    "CircuitsFilter": {
      "additionalProperties": false,
      "description": "Maximum permitted circuit-hit days in the window. ``> 250`` means ignore (docs/01 §2.6).\n\nNote the asymmetry with the other sentinels: the ignore value is a *threshold*, not a single\nmagic number, because any cap above a full year of trading days cannot bind.",
      "properties": {
        "m1": {
          "default": 999,
          "title": "M1",
          "type": "integer"
        },
        "m12": {
          "default": 999,
          "title": "M12",
          "type": "integer"
        },
        "m3": {
          "default": 999,
          "title": "M3",
          "type": "integer"
        },
        "m6": {
          "default": 999,
          "title": "M6",
          "type": "integer"
        },
        "m9": {
          "default": 999,
          "title": "M9",
          "type": "integer"
        }
      },
      "title": "CircuitsFilter",
      "type": "object"
    },
    "CustomFilter": {
      "additionalProperties": false,
      "description": "A field-to-field comparison, e.g. ``ma_50 >= ma_200`` (docs/01 §2.14).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "left": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Left",
          "type": "string"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            "="
          ],
          "title": "Op",
          "type": "string"
        },
        "right": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Right",
          "type": "string"
        }
      },
      "required": [
        "left",
        "op",
        "right"
      ],
      "title": "CustomFilter",
      "type": "object"
    },
    "ExtraFactor": {
      "additionalProperties": false,
      "description": "Factor two / factor three of the combined ranking (docs/01 §2.12).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "sort_by": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort By"
        },
        "sort_direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Direction",
          "type": "string"
        }
      },
      "title": "ExtraFactor",
      "type": "object"
    },
    "FactorRange": {
      "additionalProperties": false,
      "description": "An inclusive ``[min, max]`` eligibility filter on one factor (docs/ranking/PLAN.md C3).\n\nThis is where a non-rankable factor belongs: ``excess_ret_12m >= 0`` is a meaningful gate even\nthough a common-index subtraction can never reorder a list (PLAN correction 1). NULL never\nsatisfies a range (docs/06 step 4).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "factor": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Factor",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        }
      },
      "required": [
        "factor"
      ],
      "title": "FactorRange",
      "type": "object"
    },
    "FamilyWeights": {
      "additionalProperties": false,
      "description": "Relative weight per weight family for ``composite`` (docs/ranking/PLAN.md C3/C4).\n\n``None`` means \"no opinion\": the ranking engine gives that family the mean of the explicit\nweights of the families present (or 1 when none is explicit), then normalises the shares of the\nfamilies that actually have terms to sum to one. That makes the scale irrelevant — ``60/40`` and\n``0.6/0.4`` mean the same — and three momentum terms cannot triple momentum's share.",
      "properties": {
        "momentum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Momentum"
        },
        "participation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participation"
        },
        "path_quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Quality"
        },
        "risk_execution": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Execution"
        },
        "trend_structure": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend Structure"
        }
      },
      "title": "FamilyWeights",
      "type": "object"
    },
    "MovingAverageFilter": {
      "additionalProperties": false,
      "description": "Eight independent switches, AND-combined (docs/01 §2.3).",
      "properties": {
        "above_100": {
          "default": false,
          "title": "Above 100",
          "type": "boolean"
        },
        "above_20": {
          "default": false,
          "title": "Above 20",
          "type": "boolean"
        },
        "above_200": {
          "default": false,
          "title": "Above 200",
          "type": "boolean"
        },
        "above_50": {
          "default": false,
          "title": "Above 50",
          "type": "boolean"
        },
        "below_100": {
          "default": false,
          "title": "Below 100",
          "type": "boolean"
        },
        "below_20": {
          "default": false,
          "title": "Below 20",
          "type": "boolean"
        },
        "below_200": {
          "default": false,
          "title": "Below 200",
          "type": "boolean"
        },
        "below_50": {
          "default": false,
          "title": "Below 50",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "MovingAverageFilter",
      "type": "object"
    },
    "PeFilter": {
      "additionalProperties": false,
      "description": "P/E band behind its own switch. Undefined P/E is excluded when on (docs/01 §2.8).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "from": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        }
      },
      "title": "PeFilter",
      "type": "object"
    },
    "PositiveDaysFilter": {
      "additionalProperties": false,
      "description": "Minimum % of trading days that closed up. ``0`` means ignore (docs/01 §2.5).",
      "properties": {
        "m1": {
          "default": 0,
          "title": "M1",
          "type": "integer"
        },
        "m12": {
          "default": 0,
          "title": "M12",
          "type": "integer"
        },
        "m3": {
          "default": 0,
          "title": "M3",
          "type": "integer"
        },
        "m6": {
          "default": 0,
          "title": "M6",
          "type": "integer"
        },
        "m9": {
          "default": 0,
          "title": "M9",
          "type": "integer"
        }
      },
      "title": "PositiveDaysFilter",
      "type": "object"
    },
    "RangeFilter": {
      "additionalProperties": false,
      "description": "An inclusive ``[from, to]`` band; both ``None`` means ignore (docs/06 step 4).",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        }
      },
      "title": "RangeFilter",
      "type": "object"
    },
    "RankingTerm": {
      "additionalProperties": false,
      "description": "One explicit ranking term (docs/ranking/PLAN.md C3).\n\n``preference`` says how a raw value becomes a score in ``[0, 1]`` (C4 step 3): ``higher`` and\n``lower`` are percentiles, ``target_range`` scores distance from ``[target_min, target_max]``.\n``weight`` is only meaningful in ``composite`` mode, so any other mode refuses a non-default\nweight rather than silently ignoring it.",
      "properties": {
        "factor": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Factor",
          "type": "string"
        },
        "preference": {
          "enum": [
            "higher",
            "lower",
            "target_range"
          ],
          "title": "Preference",
          "type": "string"
        },
        "target_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Max"
        },
        "target_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Min"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "factor",
        "preference"
      ],
      "title": "RankingTerm",
      "type": "object"
    },
    "TopRiskFilter": {
      "additionalProperties": false,
      "description": "\"Ignore Top Beta / Top Volatility\" — a precomputed per-universe flag (docs/06 step 4).",
      "properties": {
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "TopRiskFilter",
      "type": "object"
    }
  },
  "$id": "https://baskfy.com/schemas/screen-definition.json",
  "additionalProperties": false,
  "description": "The persisted screen configuration.\n\nTwo definitions that mean the same thing produce the same :meth:`canonical_json`, and\ntherefore the same :meth:`definition_hash` — which is what makes the Redis cache key\n(docs/06 §Caching) and ``screen_run.definition_hash`` trustworthy.",
  "properties": {
    "apply_filters_on": {
      "default": "all",
      "enum": [
        "all",
        "decile_1",
        "decile_2",
        "decile_3",
        "decile_4",
        "decile_5",
        "top_50",
        "top_100"
      ],
      "title": "Apply Filters On",
      "type": "string"
    },
    "away_from_high": {
      "$ref": "#/$defs/AwayFromHighFilter"
    },
    "circuits": {
      "$ref": "#/$defs/CircuitsFilter"
    },
    "custom_filters": {
      "items": {
        "$ref": "#/$defs/CustomFilter"
      },
      "title": "Custom Filters",
      "type": "array"
    },
    "factor_ranges": {
      "items": {
        "$ref": "#/$defs/FactorRange"
      },
      "title": "Factor Ranges",
      "type": "array"
    },
    "factor_three": {
      "$ref": "#/$defs/ExtraFactor"
    },
    "factor_two": {
      "$ref": "#/$defs/ExtraFactor"
    },
    "family_weights": {
      "anyOf": [
        {
          "$ref": "#/$defs/FamilyWeights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "historical_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Historical Date"
    },
    "ignore_above_beta": {
      "default": 100,
      "title": "Ignore Above Beta",
      "type": "integer"
    },
    "ignore_top_beta": {
      "$ref": "#/$defs/TopRiskFilter"
    },
    "ignore_top_volatility": {
      "$ref": "#/$defs/TopRiskFilter"
    },
    "index": {
      "enum": [
        "nifty-50",
        "nifty-next-50",
        "nifty-100",
        "nifty-200",
        "nifty-500",
        "nifty-total-market",
        "nifty-large-mid-250",
        "nifty-midcap-150",
        "nifty-smallcap-250",
        "nifty-microcap-250",
        "nifty-mid-small-400",
        "nifty-allcap",
        "nifty-fno",
        "etf",
        "nse-sme-emerge"
      ],
      "title": "Index",
      "type": "string"
    },
    "marketcap": {
      "$ref": "#/$defs/RangeFilter"
    },
    "median_volume_1y": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Median Volume 1Y"
    },
    "min_return_1y": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Return 1Y"
    },
    "missing_data": {
      "default": "penalize",
      "enum": [
        "penalize",
        "neutral",
        "exclude"
      ],
      "title": "Missing Data",
      "type": "string"
    },
    "moving_average": {
      "$ref": "#/$defs/MovingAverageFilter"
    },
    "pe": {
      "$ref": "#/$defs/PeFilter"
    },
    "positive_days": {
      "$ref": "#/$defs/PositiveDaysFilter"
    },
    "price": {
      "$ref": "#/$defs/RangeFilter"
    },
    "ranking_mode": {
      "default": "composite",
      "enum": [
        "single",
        "sequential",
        "composite"
      ],
      "title": "Ranking Mode",
      "type": "string"
    },
    "ranking_scope": {
      "default": "filtered_results",
      "enum": [
        "filtered_results",
        "fixed_universe",
        "within_sector"
      ],
      "title": "Ranking Scope",
      "type": "string"
    },
    "ranking_terms": {
      "items": {
        "$ref": "#/$defs/RankingTerm"
      },
      "title": "Ranking Terms",
      "type": "array"
    },
    "regime_in": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "BULL",
              "NEUTRAL",
              "BEAR"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regime In"
    },
    "series": {
      "items": {
        "type": "string"
      },
      "title": "Series",
      "type": "array"
    },
    "sort_by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Sort By",
      "type": "string"
    },
    "sort_direction": {
      "default": "desc",
      "enum": [
        "asc",
        "desc"
      ],
      "title": "Sort Direction",
      "type": "string"
    }
  },
  "required": [
    "index",
    "sort_by"
  ],
  "title": "ScreenDefinition",
  "type": "object"
}
