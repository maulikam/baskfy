# syntax=docker/dockerfile:1.9
# Context is the repo root: docker build -f deploy/Dockerfile.rust -t baskfy-rs .

ARG RUST_IMAGE=rust:1.99.1-slim-bookworm
ARG DEBIAN_IMAGE=debian:bookworm-slim

FROM ${RUST_IMAGE} AS chef
WORKDIR /src
# Beats .cargo/config.toml's host path.
ENV CARGO_TARGET_DIR=/src/target
COPY rust-toolchain.toml ./
RUN rustup toolchain install && rustup show active-toolchain
RUN cargo install cargo-chef --locked --version 0.1.78

FROM chef AS planner
COPY Cargo.toml Cargo.lock rust-toolchain.toml rustfmt.toml deny.toml ./
COPY .cargo .cargo
COPY apps/api apps/api
COPY apps/desk apps/desk
COPY apps/worker apps/worker
COPY crates crates
RUN cargo chef prepare --recipe-path /recipe.json

FROM chef AS build
COPY --from=planner /recipe.json /recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --locked --recipe-path /recipe.json \
      -p baskfy-api -p baskfy-worker -p baskfy-desk --bins
COPY Cargo.toml Cargo.lock rust-toolchain.toml rustfmt.toml deny.toml ./
COPY .cargo .cargo
COPY apps/api apps/api
COPY apps/desk apps/desk
COPY apps/worker apps/worker
COPY crates crates
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked -p baskfy-api -p baskfy-worker -p baskfy-desk --bins \
 && install -d /out \
 && install -m 0755 target/release/baskfy-api target/release/baskfy-worker target/release/baskfy-desk /out/

# PM6.1: the MB sleeve's scorer (Python, run by the worker as /opt/mb/run). Relocatable interpreter from uv.
FROM ${DEBIAN_IMAGE} AS mb
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/mb/python UV_LINK_MODE=copy UV_PYTHON_PREFERENCE=only-managed
COPY machinelearning/python/research/portfolio-ml/requirements-mb.txt /opt/mb/requirements.txt
RUN uv venv --python 3.12 /opt/mb/venv \
 && uv pip install --python /opt/mb/venv/bin/python --no-cache -r /opt/mb/requirements.txt

FROM ${DEBIAN_IMAGE} AS runtime
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
ENV TZ=Asia/Kolkata \
    DRY_RUN=false \
    DESK_DB_BACKEND=postgres \
    RUST_BACKTRACE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata curl ca-certificates openssh-client libgomp1 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 baskfy \
 && useradd --system --uid 1001 --gid baskfy --home /desk baskfy \
 && install -d -o baskfy -g baskfy /desk /desk/app /desk/data /desk/data/uploads \
      /var/lib/baskfy /var/lib/baskfy/archive /var/lib/baskfy/state
COPY --from=build /out/ /usr/local/bin/
COPY --chown=baskfy:baskfy legacy/python/kite-momentum-rebalancer/app/templates /desk/app/templates
COPY --chown=baskfy:baskfy legacy/python/kite-momentum-rebalancer/app/static    /desk/app/static
COPY --from=mb /opt/mb /opt/mb
COPY machinelearning/python/research/portfolio-ml/portfolioml /opt/mb/app/portfolioml
COPY machinelearning/python/research/portfolio-ml/mb_task.py machinelearning/python/research/portfolio-ml/mb_paper.py \
     machinelearning/python/research/portfolio-ml/audit_moves.py machinelearning/python/research/portfolio-ml/out/paper/seed.json \
     machinelearning/python/research/portfolio-ml/explore_multibagger.py crates/providers/src/reference/nse_schemes.csv /opt/mb/app/
COPY --chmod=0755 machinelearning/python/research/portfolio-ml/mb_run.sh /opt/mb/run
# Source modes come from the checkout (some are 0600); the worker runs as baskfy.
RUN chmod -R a+rX /opt/mb
# Same BASKFY_ -> desk credential mapping as Dockerfile.desk's desk-entrypoint.
RUN cat > /usr/local/bin/baskfy-rs-entrypoint <<'EOF'
#!/bin/sh
set -eu
export KITE_API_KEY="${BASKFY_KITE_API_KEY:-${KITE_API_KEY:-}}"
export KITE_TOKEN_ENCRYPTION_KEY="${BASKFY_KITE_TOKEN_ENCRYPTION_KEY:-${KITE_TOKEN_ENCRYPTION_KEY:-}}"
exec "$@"
EOF
RUN chmod 0755 /usr/local/bin/baskfy-rs-entrypoint
RUN cat > /usr/local/bin/baskfy-rs-healthcheck <<'EOF'
#!/bin/sh
# One image, many services: only the two HTTP servers have something to probe.
cmd="$(tr '\0' ' ' </proc/1/cmdline)"
case "$cmd" in
  *"baskfy-desk service"*) exit 0 ;;
  *baskfy-desk*) exec curl -fsS -m 4 -o /dev/null http://localhost:8420/status ;;
  *baskfy-api*) exec curl -fsS -m 4 -o /dev/null http://localhost:8000/health ;;
  *) exit 0 ;;
esac
EOF
RUN chmod 0755 /usr/local/bin/baskfy-rs-healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["baskfy-rs-healthcheck"]
# Last on purpose: a SQL-only change reuses every layer above.
COPY db/migrations /usr/share/baskfy/migrations
WORKDIR /desk
USER baskfy
EXPOSE 8000 8420
ENTRYPOINT ["baskfy-rs-entrypoint"]
CMD ["baskfy-api", "--host", "0.0.0.0", "--port", "8000"]
