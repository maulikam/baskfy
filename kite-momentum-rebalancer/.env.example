# Copy to .env and fill in. Every setting the code reads is listed here; anything you
# leave out falls back to the default shown.
#
# MOST OF THESE ARE ALSO EDITABLE AT http://127.0.0.1:8420/settings, which stores an
# override in the database that BEATS this file and applies without a restart. This file
# stays the bootstrap and the fallback; reset an override there to hand a setting back.
# Editing here still requires a restart, and a database override will mask the change.
#
# NOT editable from the interface, deliberately: the credentials below, and DRY_RUN /
# INTRADAY_ENABLED / OPTIONS_ENABLED. Enabling live orders should be an act on the
# machine that runs the system, not a click in a browser.
#
# Inline comments are stripped, but a trailing space is NOT: write DRY_RUN=false, never
# "DRY_RUN=false " — the latter silently keeps simulation on.

# ---- Kite Connect ---------------------------------------------------------------------
# Create an app at https://developers.kite.trade (Rs 2000/mo subscription).
# Set the app's Redirect URL to exactly: http://127.0.0.1:8420/callback
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
PORT=8420
TOKEN_FILE=data/.kite_token.json      # access token cache; expires daily (~6am IST)

# ---- Token encryption (M16) ------------------------------------------------------------
# The daily Kite access token is stored ENCRYPTED at rest (Fernet), not as plain JSON.
# Set this and the key lives somewhere the ciphertext does not, which is the point.
# Leave it blank and the desk generates a key beside the token at 0600 and logs that it did:
# that protects the secret from being copied out in a backup or a sync, and NOT from anything
# that can already read files as this user. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KITE_TOKEN_ENCRYPTION_KEY=

# ---- SAFETY ---------------------------------------------------------------------------
# The global no-order guarantee. While true, /execute simulates: no order reaches the
# broker, no regime policy tier is committed, no rebalance is marked executed. Market-data
# caching still runs. Keep true until the plan output looks right for 2-3 sessions.
DRY_RUN=true

# Phase 4 start: the merged gateway requires user_id + broker_account_id on every
# order. This console is still one book; these stamp that pair. A second tenant is
# a different caller — never collapse a foreign principal onto these defaults.
BASKFY_SOLE_USER_ID=1
BASKFY_SOLE_BROKER_ACCOUNT_ID=1

# ---- The swing book (docs/swing) ----------------------------------------------------
# Track B in docs/swing/02-scope-and-gating.md: the code behind each of these is written,
# tested and unreachable. They are read once, at import, by app/config.py and are in
# analytics/settings.LOCKED_KEYS -- never a form field, for the same reason DRY_RUN is not.
#
# BASKFY_SWING_EXECUTION_ENABLED is the swing book's own DRY_RUN and is deliberately
# independent of DRY_RUN itself: with it false, /swing/execute runs the entire path through
# the gateway's dry-run adapter and journals simulated=true whatever DRY_RUN says. That is
# what makes the twenty paper sessions docs/swing/02 §3.2 counts a rehearsal of this code
# rather than of a different branch. Flipping it needs the five conditions in §3.
BASKFY_SWING_EXECUTION_ENABLED=false
# The 09:15-10:45 opening-range monitor.
BASKFY_SWING_MONITOR_ENABLED=false
# SW25 -- AUTO-EXECUTE. THE MONITOR CONFIRMS ITS OWN TRIGGERS, WITH NOBODY WATCHING.
#
# This is the one switch that removes the desk's FIRST non-negotiable ("Never auto-execute.
# Orders fire only from POST /execute with confirm=true"). Maulik asked for it on 5 Sep 2026
# after the consequence was put to him; docs/swing/DECISIONS-SW.md SW25 is the record.
#
# A real unattended order needs ALL THREE: DRY_RUN=false, BASKFY_SWING_EXECUTION_ENABLED=true,
# and this. Three flags rather than two so that going live and going unattended stay separate
# decisions, either reversible without the other.
#
# What it does NOT remove: the order still goes through swing_execute.execute_line, so the
# confirm-time re-derivation under the session row lock, the exposure/tier/session-cap
# refusals, the MARKET-with-protection entry cap and the GTT armed in the same call all apply
# exactly as they do to a human click. What is removed is the human.
BASKFY_SWING_AUTO_EXECUTE=false
# The 08:50/09:09 pre-open gap scan. Independent of the monitor.
BASKFY_SWING_EP_PREMARKET_ENABLED=false
# SW15 "Scan now" from the desk page: the same two rules the API applies, under the same names.
# At least this many seconds between two requests; a QUEUED/RUNNING run older than the second
# no longer counts as in flight (a worker that died must not lock the button forever).
BASKFY_SWING_SCAN_MIN_INTERVAL_SECONDS=60
BASKFY_SWING_SCAN_STALE_AFTER_SECONDS=600
# The GTT band for a SWING stop (PACK.3). STOP_MIN/STOP_MAX above are the WEEKLY book's
# 8-12%, which encode vol-scaled stops; a swing stop sits at the low of the day and is
# supposed to be tight, typically 2-6%. Passed per call so the weekly book's band is unmoved.
BASKFY_SWING_STOP_BAND_MIN=0.005
BASKFY_SWING_STOP_BAND_MAX=0.10
# The swing GTT's limit leg rests this fraction of its trigger below it (docs/swing/04 §9.4,
# PACK.8): 0.97 is a 3% cushion, so the resting LIMIT behaves like the market stop he uses
# ("I always use market stops") on a falling book. The weekly book keeps the gateway's own
# GTT_LIMIT_FRACTION (0.995); this is passed per call and moves nothing else.
BASKFY_SWING_GTT_LIMIT_FRACTION=0.97

# ---- The volume-breakout sleeve (docs/vbt) ----------------------------------------------
# The third sleeve, beside the weekly book and the swing book, and an END-OF-DAY one: the plan
# is built after the close and rebuilt before the open, so there is no monitor here, no tick
# bus and no opening range. docs/vbt/01 is the method.
#
# This sleeve's own DRY_RUN, deliberately independent of DRY_RUN itself: with it false,
# /vbt/execute runs the whole path through the gateway's dry-run branch and records
# simulated=true whatever DRY_RUN says, which is what makes docs/vbt/02 §3.1's twenty DRY_RUN
# sessions a rehearsal of THIS code. Flipping it needs the five conditions in §3.
#
# THERE IS NO BASKFY_VBT_AUTO_EXECUTE AND THERE WILL NOT BE ONE. Non-negotiable 1's named
# exception is the swing sleeve's, by Maulik's own hand (DECISIONS-SW SW25); DECISIONS-VB
# PACK.2 records why it is not copied here, and VB10 asserts that no such setting exists.
BASKFY_VBT_EXECUTION_ENABLED=false
# The GTT band for a VBT stop. STOP_MIN/STOP_MAX above are the WEEKLY book's 8-12% and the
# swing pair above is its own 0.5-10%; this strategy's stop is a flat 12% with a 15% ceiling
# (docs/vbt/04 §6.1), so its band is 0.5-15%. Passed per call; neither other book moves.
BASKFY_VBT_STOP_BAND_MIN=0.005
BASKFY_VBT_STOP_BAND_MAX=0.15
# Where the VBT GTT's limit leg rests, as a fraction of its trigger -- the same mechanism and
# the same 0.97 the swing route uses, for the same reason: a GTT fires a LIMIT order, and a
# stop resting at its own trigger can be walked through by a fast-falling book.
BASKFY_VBT_GTT_LIMIT_FRACTION=0.97
# ---- The three-weeks-tight sleeve (docs/twt) --------------------------------------------
# The fourth sleeve. An end-of-day POSITION strategy -- about eighteen entries a year, held a
# hundred sessions on average -- whose one new mechanism is the RATCHET: a 20% trailing stop
# re-armed after every close on which the name made a new high since entry.
#
# This is its own DRY_RUN, independent of DRY_RUN itself exactly as the two flags above are.
# With it false, /twt/execute runs the entire path -- guards, risk, rate limits, journal --
# through the gateway's dry-run adapter and records simulated=true whatever DRY_RUN says.
# docs/twt/02 §3 lists what must be true before it flips and NONE of it is an agent's: a green
# tree, the written runbook (docs/twt/FIRST-LIVE-MORNING.md), Maulik's own flag flip, and half
# size for the first ten live entries. No agent sets it and no agent sets the sleeve's capital.
#
# THERE IS NO BASKFY_TWT_AUTO_EXECUTE AND THERE WILL NOT BE ONE. Non-negotiable 1's named
# exception is the swing sleeve's, by Maulik's own hand (DECISIONS-SW SW25); TW10 asserts that
# no setting of that shape exists anywhere in the tree. The ratchet -- the line that would most
# like to be a background job -- is a plan line a person confirms.
#
# The TWT stop band (0.5-30%, docs/twt/04 §10.7) and its GTT cushion (0.97, §10.6) are NOT env
# knobs: both live in baskfy_core.twt.config.ExitConfig and app/twt_execute.py reads them from
# there, so the band the gateway is handed and the arithmetic that produced the trigger cannot
# be two different numbers. DECISIONS-TW TW6.5.
BASKFY_TWT_EXECUTION_ENABLED=false
# The swing notifier (SW11, docs/swing/STANDING-ANSWERS A2): a TRIGGERED signal for a
# daily-focus name is EMAILED with the whole line (symbol, entry, stop, qty, rupee risk, plan
# expiry) through this stdlib SMTP sender -- one-way; a reply cannot reach an order. Blank
# host = no email. STARTTLS on by default; set false only for a local relay such as mailpit.
DESK_SMTP_HOST=
DESK_SMTP_PORT=587
DESK_SMTP_USER=
DESK_SMTP_PASSWORD=
DESK_SMTP_STARTTLS=true
DESK_NOTIFY_FROM=
DESK_NOTIFY_TO=
# The swing monitor process (python -m app.swing_monitor) exports its own metrics (M20's
# prometheus_client) on this port when METRICS_PORT is set; blank = METRICS_PORT + 1.
DESK_MONITOR_METRICS_PORT=
# Telegram, scaffolded dark: the sender is constructed only when BOTH are set, sends one
# message per signal, and has no command handler, no polling and no reply path. Leave blank.
BASKFY_SWING_TELEGRAM_BOT_TOKEN=
BASKFY_SWING_TELEGRAM_CHAT_ID=
# The M4.1 ceilings for sw_config (docs/swing/03 §1). They are READ by the data plant's API
# and worker, not by this console; they are listed here because analytics/settings.LOCKED_KEYS
# locks them out of the settings route, and so the two trees document the same numbers. His
# words (docs/swing/07): "rarely more than 1%"; "never more than 30% of your account over
# night in any stock"; "15-20 positions in a good market".
BASKFY_SWING_RISK_PER_TRADE_PCT_MAX=1.0
BASKFY_SWING_MAX_POSITION_PCT_MAX=30.0
BASKFY_SWING_MAX_OPEN_POSITIONS_MAX=20

# Leave the machine on IPv4 for every broker call. Kite authorises order placement against
# an allowlist of IP addresses; this connection offers both families and prefers IPv6, so
# on 19 Aug 2026 a whole rebalance was refused for an address (a rotating residential v6
# prefix) that cannot usefully be allowlisted, while the v4 address sat in the console.
# Set false only on a host whose IPv6 address is itself static and allowlisted.
FORCE_IPV4=true

# --- interface security ---------------------------------------------------------------
# The desk places real orders and is reached over an SSH tunnel, so it binds to loopback
# and answers only to these names. A request arriving as anything else is how a browser is
# tricked into treating this app as an attacker's own site (DNS rebinding), so it is
# refused before it routes.
DESK_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DESK_PORT=8420

# SET THIS ON ANY HOSTED OR SHARED BOX. Loopback is not a boundary between users of the
# same machine: without a password every route here is reachable by anything on the host
# that can open a socket. Empty is correct for a personal laptop and nothing else.
# Any username works; the password is what is checked.
DESK_PASSWORD=

# The interactive API docs enumerate every route, including the ones that place orders.
DESK_DOCS=false

# Product gates, enforced inside core/gateway.py before any order. The rebalancer is
# CNC-only; leave both false unless you are deliberately enabling those engines.
INTRADAY_ENABLED=false                # MIS / intraday
OPTIONS_ENABLED=false                 # NFO / BFO

# Option strategy research settings. These affect planning only; the two product gates
# above and DRY_RUN still decide whether an order can reach the broker.
OPTION_UNDERLYING=NIFTY
OPTION_INTRADAY_SQUARE_OFF=15:12
OPTION_SELL_MONTHLY_BENCHMARK_PCT=5.0 # benchmark, not a guaranteed or forced return
OPTION_SELL_ENTRY_START=09:45
OPTION_SELL_ENTRY_END=13:30
OPTION_SELL_RISK_PER_TRADE_PCT=0.75
OPTION_SELL_SHORT_DELTA=0.16
OPTION_SELL_WING_DELTA=0.05
OPTION_SELL_TARGET_CAPTURE_PCT=35
OPTION_SELL_STOP_CREDIT_MULTIPLE=1.5
OPTION_BUY_TRADE_BENCHMARK_PCT=15.0    # activates trailing profit management
OPTION_BUY_ENTRY_START=09:35
OPTION_BUY_ENTRY_END=14:30
OPTION_BUY_RISK_PER_TRADE_PCT=0.50
OPTION_BUY_DELTA=0.60
OPTION_BUY_PREMIUM_STOP_PCT=25
OPTION_BUY_TRAIL_ACTIVATION_PCT=15
OPTION_BUY_TRAIL_DRAWDOWN_PCT=8

# ---- Risk limits ----------------------------------------------------------------------
# Enforced on every order by core/risk.py. Leave the two rupee caps BLANK to derive them
# from live NAV, so they cannot contradict the strategy's own sizing as the book grows:
# a fixed cap of Rs 15L silently forbade the Rs 15.8L position MAX_SINGLE_WEIGHT allows.
RISK_MAX_POSITION_VALUE=              # blank = MAX_SINGLE_WEIGHT% of NAV x headroom
RISK_MAX_GROSS_EXPOSURE=              # blank = NAV x RISK_GROSS_MULTIPLE
RISK_POSITION_HEADROOM=1.25           # room for price movement between plan and fill
RISK_GROSS_MULTIPLE=1.5
RISK_MAX_DAILY_LOSS_PCT=5.0           # kill switch: halts trading for the day at this loss
RISK_MAX_ORDERS_PER_DAY=500           # our own cap, well under Kite's 3000

# ---- Portfolio ------------------------------------------------------------------------
FULLY_INVESTED=false                  # true = ignore the breadth-driven cash bands
DB_PATH=data/portfolio.db             # SQLite: snapshots, benchmarks, regime, trades
# Untouchable instruments (SGB/G-sec) are recorded in every snapshot but kept OUT of
# nav/invested, so their P&L is not attributed to the momentum strategy. Set true to
# track total account value instead.
INCLUDE_UNTOUCHABLE_IN_NAV=false

# ---- Tax lots -------------------------------------------------------------------------
# There is no historical tradebook API, so FIFO lots come from a Console export:
#   console.zerodha.com -> Reports -> Tradebook -> download CSV
#   python -m app.analytics.tradebook --file data/uploads/tradebook.csv --reconcile
# Until that is imported, every tax review returns TAX_DATA_UNKNOWN and requires manual
# review, which is the correct fail-safe: no sale is ever assumed tax-safe.

# ---- Regime overlay -------------------------------------------------------------------
# Three independent switches. REGIME_ENABLED is the feature; REGIME_MODE is how far a
# decision may travel; DRY_RUN above still overrides everything.
REGIME_ENABLED=false                  # master switch for the overlay
REGIME_MODE=observe                   # observe | propose | enforce
#   observe  calculate and display only, no executable plan
#   propose  build a plan for review; it runs only on explicit approval
#   enforce  an approved plan may be sent through the order gateway

# Signal shape
REGIME_BUFFER_BPS=150                 # Schmitt-trigger band around each MA (150 = 1.50%)
REGIME_CONFIRM_DAYS=3                 # consecutive closes needed to confirm a side
REGIME_WEEKLY_EVAL_WEEKDAY=4          # 0=Mon .. 4=Fri

# Data quality. Degraded inputs may block new buys but never force selling on their own.
REGIME_INDEX_STALE_DAYS=5             # index candles older than this are stale
REGIME_BREADTH_STALE_DAYS=10
REGIME_MIN_BREADTH_COVERAGE_PCT=90    # below this, breadth cannot force or permit anything

# Exposure and sizing
REGIME_R4_EQUITY_PCT=10               # R4 cap. Set 0 for genuine full cash.
REGIME_R4_MAX_RESIDUAL_NAMES=2        # 0 forces R4 to full cash rather than inventing names
REGIME_R4_RESIDUAL_ORDERING=rank,liquidity
REGIME_HALF_SIZE_FACTOR=0.5           # R2 provisional entries, as a fraction of full size
REGIME_NEARBY_RANK_BAND=3             # rank band within which losers are sold before winners

# Policy
REGIME_BOOTSTRAP_POLICY=observe_only  # observe_only | adopt_candidate
#   observe_only never generates forced sells merely because no prior state exists
REGIME_LTCG_REVIEW_DAYS=45            # flag a profitable lot this close to long-term

# --- the merged pipeline (M13, M14) -----------------------------------------------------------
# The screener's database. Read-only from the desk: it supplies bars for a generated scan
# (/analyze?generate_for=YYYY-MM-DD) and the 20-DMA breadth the cash bands key off.
SCREENER_DATABASE_URL=postgresql://baskfy:baskfy@localhost:5433/baskfy
# The index universe the weekly scan corresponds to. Verified equal to the desk's 271-row scan,
# symbol for symbol, on 2026-08-18 — both sides then report 68.6347% above the 20-DMA. The desk
# re-checks the membership per plan rather than trusting it, and falls back to the scan's own
# breadth whenever the sets differ.
DESK_UNIVERSE_SLUG=nifty-total-market
# "upload" (default) or "generated". See docs/SHADOW-MODE.md — this is the flag that four green
# Fridays of shadow mode buy. It is off, and flipping it early is not a shortcut.
SCAN_SOURCE_DEFAULT=upload

# --- M19 §3: which database the desk's own records live in ------------------------------------
# "sqlite" (the default, and what the Mumbai box runs) or "postgres" (the merged backend).
# THE DEFAULT STAYS sqlite. The box has no Postgres, so a code-level default of "postgres" would
# break it on the next deploy, silently, at 18:30. Opting in is a local .env change and rolling
# back is the same variable in reverse.
DESK_DB_BACKEND=sqlite
# Where M18's migration put the desk's nineteen tables: a schema of its own, so they cannot
# collide with the screener's forty-two in `public`.
DESK_DB_SCHEMA=desk
DESK_DATABASE_URL=postgresql://baskfy:baskfy@localhost:5433/baskfy

# --- M20 §1: observability over the order path ------------------------------------------------
# Each of these three switches on one view, and each is OFF when unset. The libraries are optional
# too: absent, every helper degrades to a no-op. Observability must never be the reason an order
# does not get placed, so nothing in app/telemetry.py can raise into the order path.
# Spans for plan -> execute -> GTT. Set to an OTLP/HTTP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=momentum-desk
# Exceptions, with the plan id attached. No PII, no prices, no quantities.
SENTRY_DSN=
# A port for Prometheus to scrape. Unset means no HTTP server is started at all.
METRICS_PORT=

# --- SW21: the shared Kite read limiter (app/core/kite_limits.py) -----------------------------
# The box runs the desk as two processes — the web container and `swing-monitor` — and Kite's read
# caps are per API key, not per container. Point both at the box's Redis and they queue behind one
# departure clock per endpoint family (`baskfy:ratelimit:kite:{quote,historical,general}`), which
# is the same Redis and the same namespace the api and the worker already use.
#
# UNSET IS FINE and is what a laptop should be: each process then holds its own spacers, exactly
# as it did before SW21. An unreachable Redis degrades the same way, logs it, and retries once a
# minute — the limiter is never allowed to be the reason a Friday rebalance cannot run.
# `GET /status` reports which of the two modes this process is in ("read_limiter").
BASKFY_REDIS_URL=
# The reversal, in one variable: false puts every process back on its own spacers.
DESK_SHARED_READ_LIMITS=true
