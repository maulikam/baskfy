# Tree 6: App Router hub `/build` must not match the Python `build/` ignore.
!apps/web/src/app/(app)/build/
!apps/web/src/app/(app)/build/**
*.egg-info/
.next/
.turbo/
.env
.secrets/
.archive/
# Local pg_dump output (infra/backup/pg_backup.sh). Never committed: it is the database.
.backups/
.env.*
!.env.example
.DS_Store
.overnight/

# Prompt 16: one JSON file per measurement, written by `make bench`. The rendered table
# (benchmarks/AS-MEASURED.md) is committed; the raw samples are not — they are machine-specific.
benchmarks/results/

# Prompt 19's mutation harness: throwaway copies of baskfy_core, one per worker.
.mutants/
coverage.json

# Kite access tokens, and the bootstrap encryption key the token store writes beside one when
# KITE_TOKEN_ENCRYPTION_KEY is unset. `.secrets/` above covers the configured path; these cover
# the fallback, which is what a script run from the wrong working directory produces. One was
# staged on 22 Aug 2026 by exactly that mistake (DECISIONS-MERGE M23.5).
*.kite_token.json
*.kite_token.json.key
*.enc.key

# M37: the 4096px logo master and the throwaway comparison sheets the 16px acceptance produced.
# The build script is committed and the derived assets are committed; the 11 MB source is not —
# it lives at the CloudFront URL recorded in docs/DECISIONS-MERGE.md §M37.1 and is re-downloadable.
apps/web/brand-src/baskfy-mark-source.png
apps/web/brand-src/_*.png
apps/web/brand-src/16px-check.png
