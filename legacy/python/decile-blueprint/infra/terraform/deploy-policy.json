{
  "Version": "2012-10-17",
  "Comment": [
    "Least-privilege policy for applying decile-blueprint/infra/terraform (docs/08 Phase A).",
    "Derived from the 29 resources and 4 data sources the configuration actually declares, not",
    "guessed. Attach to the role or user Terraform assumes.",
    "",
    "If you would rather not maintain this: use IAM Identity Center with AdministratorAccess for",
    "the first apply. In a single-owner account the real risk is not over-permission, it is a",
    "long-lived access key sitting on a laptop -- and SSO removes that one. This policy exists for",
    "when a second person or a CI runner needs to apply, which is when scoping starts to matter.",
    "",
    "JSON has no comments; AWS ignores unknown top-level keys, so this one survives a paste."
  ],
  "Statement": [
    {
      "Sid": "NetworkAndCompute",
      "Comment": "VPC, subnet, IGW, route table, security group, EIP, the instance, its EBS volume, and the AMI lookup. ec2:Describe* is unavoidably broad -- the API does not scope Describe calls by resource.",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateVpc", "ec2:DeleteVpc", "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet", "ec2:DeleteSubnet", "ec2:ModifySubnetAttribute",
        "ec2:CreateInternetGateway", "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway", "ec2:DetachInternetGateway",
        "ec2:CreateRouteTable", "ec2:DeleteRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute",
        "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable",
        "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress",
        "ec2:AllocateAddress", "ec2:ReleaseAddress",
        "ec2:AssociateAddress", "ec2:DisassociateAddress",
        "ec2:RunInstances", "ec2:TerminateInstances",
        "ec2:StartInstances", "ec2:StopInstances",
        "ec2:ModifyInstanceAttribute", "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:CreateTags", "ec2:DeleteTags",
        "ec2:CreateVolume", "ec2:DeleteVolume", "ec2:AttachVolume", "ec2:DetachVolume"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ArchiveBucket",
      "Comment": "Only the archive bucket and the Terraform state bucket. Not s3:* on *.",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:DeleteBucket",
        "s3:GetBucket*", "s3:PutBucket*", "s3:ListBucket",
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectVersion",
        "s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration",
        "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration",
        "s3:GetAccelerateConfiguration", "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::baskfy-archive", "arn:aws:s3:::baskfy-archive/*",
        "arn:aws:s3:::baskfy-tfstate", "arn:aws:s3:::baskfy-tfstate/*"
      ]
    },
    {
      "Sid": "InstanceRoleAndProfile",
      "Comment": "Scoped to the two role names the configuration creates. iam:PassRole is what lets the instance be launched WITH its profile -- without it RunInstances fails with an opaque error.",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies",
        "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
        "iam:ListInstanceProfilesForRole",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/baskfy-phase-a-box",
        "arn:aws:iam::*:role/baskfy-dlm",
        "arn:aws:iam::*:instance-profile/baskfy-phase-a-box"
      ]
    },
    {
      "Sid": "DnsSnapshotsAuditBudget",
      "Comment": "Route 53 zone and record, the DLM snapshot policy, CloudTrail, and the budget alarm. None of these support resource-level scoping for the create calls.",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHostedZone", "route53:DeleteHostedZone",
        "route53:GetHostedZone", "route53:ListHostedZones", "route53:ListHostedZonesByName",
        "route53:ChangeResourceRecordSets", "route53:ListResourceRecordSets",
        "route53:GetChange", "route53:ChangeTagsForResource", "route53:ListTagsForResource",
        "dlm:CreateLifecyclePolicy", "dlm:DeleteLifecyclePolicy",
        "dlm:GetLifecyclePolicy", "dlm:GetLifecyclePolicies", "dlm:UpdateLifecyclePolicy",
        "dlm:TagResource", "dlm:ListTagsForResource",
        "cloudtrail:CreateTrail", "cloudtrail:DeleteTrail", "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrail", "cloudtrail:GetTrailStatus", "cloudtrail:UpdateTrail",
        "cloudtrail:StartLogging", "cloudtrail:StopLogging",
        "cloudtrail:AddTags", "cloudtrail:ListTags", "cloudtrail:GetEventSelectors",
        "budgets:CreateBudget", "budgets:DeleteBudget", "budgets:ModifyBudget",
        "budgets:DescribeBudget", "budgets:ViewBudget",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ShellAccessAndImages",
      "Comment": "Not needed by terraform apply. Needed by the human afterwards: SSM is the ONLY way onto the box (docs/08 section 3, no SSH keys), and ECR is where the two container images go.",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession", "ssm:TerminateSession", "ssm:ResumeSession",
        "ssm:DescribeSessions", "ssm:DescribeInstanceInformation",
        "ssm:GetConnectionStatus", "ssm:SendCommand", "ssm:GetCommandInvocation",
        "ecr:GetAuthorizationToken", "ecr:CreateRepository", "ecr:DescribeRepositories",
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage",
        "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "*"
    }
  ]
}
