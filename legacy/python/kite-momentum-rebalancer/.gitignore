# --- SECRETS: never commit -------------------------------------------------------
# .env holds the live Kite API key and secret; .kite_token.json holds an access token
# that grants full account read plus order placement until it expires.
.env
data/.kite_token.json
# ...and the key that decrypts it. This line was missing until 26 Aug 2026: the ciphertext was
# ignored and the Fernet key beside it was committed in 44c029c (22 Aug) and pushed to
# origin/developer. Ignoring the ciphertext while committing its key protects nothing. The glob
# covers the whole family so a future `.kite_token.json.key.bak` cannot repeat it.
data/.kite_token.json.*
data/*.key

# --- environment -------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- generated data ------------------------------------------------------------------
# The SQLite book is reproducible from Kite + scans, and its WAL files are machine state.
data/portfolio.db
data/portfolio.db-wal
data/portfolio.db-shm
data/.instruments_*.json
# NSE's index board and constituent lists — a cache of public data, refetched on demand.
# Committing it would also freeze a market snapshot into the repo.
data/.nse_*.json
data/outputs/
data/uploads/*.csv
!data/uploads/.gitkeep

# --- os / editor ---------------------------------------------------------------------
.DS_Store
*.swp
node_modules/
data/backups/
