{
  "mode": "writes",
  "lane": "writes-foundation",
  "note": "Wave 4c foundation: the account and session writes (PATCH/DELETE /me, POST /me/restore, POST /auth/google|refresh|logout) as one scenario on two fresh clones of the bed. Run with: python3 tools/parity/api_diff.py --writes --lane <lane> --smtp-port <port> --py-port P --rs-port R --cases tools/parity/api_cases/writes_foundation.json. Seeded: three refresh tokens whose plaintexts the scenario knows (owner, an expired one for user 6, one for user 3); timestamps fixed so the seed is identical in every clone.",
  "seed_sql": [
    "INSERT INTO refresh_token (user_id, family_id, token_hash, issued_at, expires_at) VALUES (1, 'rsparityfamily00000000000000001', encode(sha256('rs-parity-refresh-owner-0001'::bytea), 'hex'), '2026-10-01T00:00:00Z', '2027-01-01T00:00:00Z'), (6, 'rsparityfamily00000000000000006', encode(sha256('rs-parity-refresh-expired-0006'::bytea), 'hex'), '2026-01-01T00:00:00Z', '2026-02-01T00:00:00Z'), (3, 'rsparityfamily00000000000000003', encode(sha256('rs-parity-refresh-user3-0003'::bytea), 'hex'), '2026-10-01T00:00:00Z', '2027-01-01T00:00:00Z')"
  ],
  "db_mask": {
    "refresh_token": [
      "family_id",
      "token_hash",
      "issued_at",
      "expires_at",
      "revoked_at"
    ],
    "account_deletion": [
      "requested_at",
      "purge_after",
      "cancelled_at"
    ],
    "app_user": [
      "deleted_at",
      "email_verified_at"
    ]
  },
  "tables": [
    "app_user",
    "refresh_token",
    "account_deletion",
    "auth_identity",
    "consent_record"
  ],
