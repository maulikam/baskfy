{
  "lane": "foundation",
  "note": "RS4b foundation: the pipeline (routing, problem+json, auth, CORS, ETag) and the plumbing routes. Every case here must be EQUAL.",
  "cases": [
    {"name": "health", "method": "GET", "path": "/health", "note": "liveness, no DB, no rate limit"},
    {"name": "health-slash-redirect", "method": "GET", "path": "/health/", "note": "Starlette redirect_slashes: 307 to /health"},
    {"name": "health-head", "method": "HEAD", "path": "/health", "note": "FastAPI routes never answer HEAD: 405"},
    {"name": "unrouted-under-api", "method": "GET", "path": "/api/v1/nothing-here", "note": "framework 404 through the problem handler"},
    {"name": "unrouted-root", "method": "GET", "path": "/nothing", "note": "outside /api/v1 too"},
    {"name": "unrouted-slash-root", "method": "GET", "path": "/", "note": "no redirect for /"},
    {"name": "unrouted-with-bad-token", "method": "GET", "path": "/api/v1/nothing-here", "user": "garbage", "note": "no route matched, so no principal: 404 not 401"},
    {"name": "wrong-method", "method": "POST", "path": "/api/v1/meta/columns", "body": {}, "note": "405 internal-error, status kept, no Allow header"},
    {"name": "head-on-get-route", "method": "HEAD", "path": "/api/v1/meta/columns", "note": "405"},
    {"name": "trailing-slash-redirect", "method": "GET", "path": "/api/v1/me/", "note": "307 to /api/v1/me, before any auth"},
    {"name": "trailing-slash-redirect-query", "method": "POST", "path": "/api/v1/meta/columns/", "query": "a=1&b=x%20y", "note": "the redirect keeps the query, for any method (partial match)"},
    {"name": "slash-redirect-other-way", "method": "GET", "path": "/api/v1/meta/factors//", "note": "rstrip('/') strips every trailing slash"},
    {"name": "encoded-slash-routes", "method": "GET", "path": "/api/v1/meta%2Fcolumns", "note": "Starlette routes the decoded path"},
    {"name": "encoded-unknown-path-instance", "method": "GET", "path": "/api/v1/caf%C3%A9%20x", "note": "instance is the decoded path"},

    {"name": "factors-anonymous", "method": "GET", "path": "/api/v1/meta/factors", "note": "registry from baskfy_core, ETag without a data version"},
    {"name": "factors-owner", "method": "GET", "path": "/api/v1/meta/factors", "user": "owner"},
    {"name": "columns", "method": "GET", "path": "/api/v1/meta/columns"},
    {"name": "columns-if-none-match", "method": "GET", "path": "/api/v1/meta/columns", "headers": {"If-None-Match": "W/\"d37a57dc71d7748a98a886db24c31ea6\""}, "note": "304, no body, same validators"},
    {"name": "columns-if-none-match-star", "method": "GET", "path": "/api/v1/meta/columns", "headers": {"If-None-Match": "*"}},
    {"name": "columns-if-none-match-stale", "method": "GET", "path": "/api/v1/meta/columns", "headers": {"If-None-Match": "W/\"v1-0000\", \"x\""}, "note": "200 with body"},
    {"name": "columns-garbage-token", "method": "GET", "path": "/api/v1/meta/columns", "user": "garbage", "note": "a bad token is refused even on a public route"},
    {"name": "columns-empty-bearer", "method": "GET", "path": "/api/v1/meta/columns", "user": "empty_bearer", "note": "'Bearer ' with nothing after it is anonymous"},
    {"name": "columns-request-id-echo", "method": "GET", "path": "/api/v1/meta/columns", "headers": {"X-Request-Id": "edge-request-1"}},

    {"name": "trading-days", "method": "GET", "path": "/api/v1/meta/trading-days", "query": {"from": "2026-09-01", "to": "2026-10-31"}},
    {"name": "trading-days-year", "method": "GET", "path": "/api/v1/meta/trading-days", "query": {"from": "2025-01-01", "to": "2025-12-31"}, "user": "owner"},
    {"name": "trading-days-last-value-wins", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=2026-10-01&to=2026-10-10&from=2026-10-05&junk=1"},
    {"name": "trading-days-midnight-datetime", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=2026-10-01T00:00:00&to=2026-10-09T00:00:00Z"},
    {"name": "trading-days-empty-range", "method": "GET", "path": "/api/v1/meta/trading-days", "query": {"from": "2026-10-03", "to": "2026-10-04"}, "note": "a weekend: dates []"},
    {"name": "trading-days-reversed", "method": "GET", "path": "/api/v1/meta/trading-days", "query": {"from": "2026-10-10", "to": "2026-10-01"}, "note": "422 no-trading-day"},
    {"name": "trading-days-too-long", "method": "GET", "path": "/api/v1/meta/trading-days", "query": {"from": "2020-01-01", "to": "2026-10-01"}},
    {"name": "trading-days-exactly-max", "method": "GET", "path": "/api/v1/meta/trading-days", "query": {"from": "2016-01-01", "to": "2021-01-04"}, "note": "1830 days: allowed"},
    {"name": "trading-days-missing-both", "method": "GET", "path": "/api/v1/meta/trading-days", "note": "400 with two missing errors"},
    {"name": "trading-days-bad-dates", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=2026-13-01&to=x"},
    {"name": "trading-days-inexact", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=2026-10-01T10:00:00&to=1790000000"},
    {"name": "trading-days-timestamp", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=1790035200&to=2026-10-10", "note": "a midnight unix timestamp is a date"},
    {"name": "trading-days-blank", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=&to=2026-10-10"},
    {"name": "trading-days-year-zero", "method": "GET", "path": "/api/v1/meta/trading-days", "query": "from=0000-01-01&to=2026-10-10"},

    {"name": "me-owner", "method": "GET", "path": "/api/v1/me", "user": "owner", "note": "overrides grant the paid bundle; no subscription"},
    {"name": "me-subscriber", "method": "GET", "path": "/api/v1/me", "user": "subscriber", "note": "an active forever plan"},
    {"name": "me-plain", "method": "GET", "path": "/api/v1/me", "user": "plain", "note": "tenant isolation: another user's own profile only"},
    {"name": "me-anonymous", "method": "GET", "path": "/api/v1/me", "note": "401 with WWW-Authenticate"},
    {"name": "me-stale-epoch", "method": "GET", "path": "/api/v1/me", "user": "stale_epoch", "note": "token epoch below the account's: revoked"},
    {"name": "me-expired", "method": "GET", "path": "/api/v1/me", "user": "expired"},
    {"name": "me-too-long", "method": "GET", "path": "/api/v1/me", "user": "too_long"},
    {"name": "me-wrong-key", "method": "GET", "path": "/api/v1/me", "user": "wrong_key"},
    {"name": "me-unknown-subject", "method": "GET", "path": "/api/v1/me", "user": "unknown"},
    {"name": "me-alg-none", "method": "GET", "path": "/api/v1/me", "user": "alg_none"},
    {"name": "me-garbage", "method": "GET", "path": "/api/v1/me", "user": "garbage"},
    {"name": "me-post", "method": "POST", "path": "/api/v1/me", "user": "owner", "body": {}, "note": "405: GET/PATCH/DELETE only (PATCH not ported: compared on POST)"},

    {"name": "cors-preflight", "method": "OPTIONS", "path": "/api/v1/me", "headers": {"Origin": "http://localhost:3000", "Access-Control-Request-Method": "GET", "Access-Control-Request-Headers": "authorization, x-request-id"}},
    {"name": "cors-preflight-bad-origin", "method": "OPTIONS", "path": "/api/v1/me", "headers": {"Origin": "https://evil.example", "Access-Control-Request-Method": "PUT", "Access-Control-Request-Headers": "x-evil"}},
    {"name": "cors-simple-allowed", "method": "GET", "path": "/api/v1/meta/columns", "headers": {"Origin": "http://localhost:3000"}, "note": "Vary: Authorization, Origin"},
    {"name": "cors-simple-disallowed", "method": "GET", "path": "/health", "headers": {"Origin": "https://evil.example"}},
    {"name": "cors-on-a-problem", "method": "GET", "path": "/api/v1/me", "headers": {"Origin": "http://localhost:3000"}, "note": "a 401 carries CORS headers too"},
    {"name": "cors-options-without-preflight", "method": "OPTIONS", "path": "/api/v1/me", "headers": {"Origin": "http://localhost:3000"}, "note": "no Access-Control-Request-Method: routed, 405"}
  ]
}
