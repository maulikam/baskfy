      "updated_at"
    ],
    "public.vb_fill": [
      "created_at"
    ],
    "public.vb_order": [
      "updated_at"
    ],
    "public.vb_position": [
      "created_at",
      "updated_at"
    ],
    "public.vb_scan_run": [
      "created_at"
    ]
  },
