{
  "note": "Wave D views lane (analytics.rs + session.rs): settings, operations, status, login, static. Every POST here is refused or DB-only; no case starts an operation (its subprocess output and timings are not comparable).",
  "cases": [
    {"name": "settings page", "method": "GET", "path": "/settings"},
    {"name": "settings data", "method": "GET", "path": "/settings/data"},
    {"name": "settings page with banners", "method": "GET", "path": "/settings", "query": {"saved": "2 changed: A, B", "error": "<b>x</b> & 'y'"}},
    {"name": "save refuses a bad float and a bad pair together", "method": "POST", "path": "/settings", "form": {"MAX_SINGLE_WEIGHT": "abc", "TARGET_POSITIONS": "14,10", "note": "bad"}},
    {"name": "save refuses a jointly impossible set", "method": "POST", "path": "/settings", "form": {"MIN_POSITION_WEIGHT": "20", "MAX_SINGLE_WEIGHT": "15"}},
    {"name": "save refuses R4 above R3", "method": "POST", "path": "/settings", "form": {"REGIME_R4_EQUITY_PCT": "45"}},
    {"name": "save refuses a choice outside its list", "method": "POST", "path": "/settings", "form": {"REGIME_MODE": "yolo"}},
    {"name": "locked and secret keys are ignored, so nothing changes", "method": "POST", "path": "/settings", "form": {"DRY_RUN": "false", "KITE_API_KEY": "x", "BASKFY_SWING_AUTO_EXECUTE": "true"}},
    {"name": "save two changes with a note", "method": "POST", "path": "/settings", "form": {"TARGET_POSITIONS": "10, 14", "STOP_MIN": "0.07", "note": "tighter book"}},
    {"name": "form bools: an unchecked rendered box means false", "method": "POST", "path": "/settings", "form": {"_form_bools": "FULLY_INVESTED,REGIME_ENABLED", "REGIME_ENABLED": "on", "REGIME_WEEKLY_EVAL_WEEKDAY": "3"}},
    {"name": "settings page after the saves", "method": "GET", "path": "/settings"},
    {"name": "settings data after the saves", "method": "GET", "path": "/settings/data"},
    {"name": "saving the value already in force changes nothing", "method": "POST", "path": "/settings", "form": {"STOP_MIN": "0.07"}},
    {"name": "reset one key", "method": "POST", "path": "/settings/reset", "form": {"key": "STOP_MIN"}},
    {"name": "reset all", "method": "POST", "path": "/settings/reset", "form": {}},
    {"name": "settings data after reset", "method": "GET", "path": "/settings/data"},
    {"name": "operations page", "method": "GET", "path": "/ops"},
    {"name": "operations page with banners", "method": "GET", "path": "/ops", "query": {"started": "daily_check", "error": "nope"}},
    {"name": "operations data", "method": "GET", "path": "/ops/data"},
    {"name": "an unknown operation is refused", "method": "POST", "path": "/ops/run", "form": {"op": "rm -rf /"}},
    {"name": "a bad date never starts", "method": "POST", "path": "/ops/run", "form": {"op": "backtest", "start": "2024-13-01"}},
    {"name": "a scan outside uploads never starts", "method": "POST", "path": "/ops/run", "form": {"op": "daily", "scan": "../../app/main.py"}},
    {"name": "an unknown job is 404", "method": "GET", "path": "/ops/job/999999"},
    {"name": "a non-integer job id is 422", "method": "GET", "path": "/ops/job/abc"},
    {"name": "status", "method": "GET", "path": "/status"},
    {"name": "login redirects to Kite", "method": "GET", "path": "/login"},
    {"name": "the stylesheet", "method": "GET", "path": "/static/app.css"},
    {"name": "the logo", "method": "GET", "path": "/static/logo.svg"},
    {"name": "the favicon", "method": "GET", "path": "/static/favicon.ico"},
    {"name": "the font", "method": "GET", "path": "/static/fonts/inter-latin.woff2"},
    {"name": "a missing static file", "method": "GET", "path": "/static/missing.css"}
  ]
}
